    },
    {
      "id": "s_fundamental_group_of_rp2",
      "kind": "theorem",
      "name": "Fundamental group of the real projective plane",
      "type_signature": "",
      "description": "The fundamental group pi_1(RP^2) is isomorphic to Z/2Z."
    },
    {
      "id": "s_surface_2_manifold",
      "kind": "axiom",
      "name": "Surface (2-manifold)",
