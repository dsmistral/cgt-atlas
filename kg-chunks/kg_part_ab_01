      "kind": "axiom",
      "name": "Optional Time",
      "type_signature": "",
      "description": "A random time T:Omega->[0,infinity] such that {T<t} belongs to F_t for every t>=0."
    },
    {
      "id": "s_optional_stopping_time_equivalence",
      "kind": "theorem",
      "name": "Equivalence of Optional and Stopping Times under Right-Continuity",
      "type_signature": "",
      "description": "When the filtration is right-continuous, a random time is an optional time if and only if it is a stopping time, i.e. {T<t} in F_t for all t is equivalent to {T<=t} in F_t for all t."
    },
    {
      "id": "s_stopping_time_closure_properties",
      "kind": "theorem",
      "name": "Closure Properties of Stopping Times",
      "type_signature": "",
      "description": "If S and T are stopping times then S∧T, S∨T, S+T, and (for a right-continuous filtration) suprema, infima, limsups and liminfs of countable families of stopping times are again stopping times."
    },
    {
      "id": "s_stopping_time_sigma_algebra_F_T",
      "kind": "axiom",
      "name": "Stopping-Time Sigma-Algebra F_T",
      "type_signature": "",
      "description": "The collection F_T = {A in F : A∩{T<=t} in F_t for all t>=0} of events determined by time T, which forms a sigma-algebra."
    },
    {
      "id": "s_properties_of_F_T",
      "kind": "theorem",
      "name": "Properties of the Stopping-Time Sigma-Algebra",
      "type_signature": "",
      "description": "For stopping times S<=T one has F_S subset F_T, T is F_T-measurable, F_{S∧T}=F_S∩F_T, and events such as {S<T},{S=T},{S<=T} lie in both F_S and F_T."
    },
    {
      "id": "s_hitting_time_of_set_is_stopping_time",
      "kind": "theorem",
      "name": "Hitting Time of a Set is a Stopping Time",
      "type_signature": "",
      "description": "For a right-continuous adapted process and a usual-conditions filtration, the first hitting (debut) time of an open set is an optional time and that of a closed set is a stopping time."
    },
    {
      "id": "s_optional_sampling_for_ui_martingales",
      "kind": "theorem",
      "name": "Optional Sampling for Uniformly Integrable Martingales",
      "type_signature": "",
      "description": "If (M_t) is a uniformly integrable martingale with last element M_infinity and S<=T are stopping times, then E[M_T|F_S]=M_S a.s., so M_T=E[M_infinity|F_T]."
    },
    {
      "id": "s_modification_vs_indistinguishability",
      "kind": "theorem",
      "name": "Modification versus Indistinguishability",
      "type_signature": "",
      "description": "Two processes that are modifications of each other (P(X_t=Y_t)=1 for each t) and are both right-continuous are indistinguishable (P(X_t=Y_t for all t)=1)."
    },
    {
      "id": "s_progressive_measurability_of_rcll_adapted",
      "kind": "theorem",
      "name": "Progressive Measurability of Right-Continuous Adapted Processes",
      "type_signature": "",
      "description": "Every adapted process with right-continuous (or left-continuous) paths is progressively measurable."
    },
    {
      "id": "s_natural_increasing_process",
      "kind": "axiom",
      "name": "Natural Increasing Process",
      "type_signature": "",
      "description": "An integrable right-continuous increasing process A such that E[∫ M_s dA_s]=E[∫ M_{s-} dA_s] for every bounded right-continuous martingale M, equivalently a predictable increasing process."
    },
    {
      "id": "s_meyer_process",
      "kind": "axiom",
      "name": "Meyer Process",
      "type_signature": "",
      "description": "The unique natural (predictable) integrable increasing process appearing in the Doob–Meyer decomposition of a submartingale of class DL."
    },
    {
      "id": "s_increasing_process",
      "kind": "axiom",
      "name": "Increasing Process",
      "type_signature": "",
      "description": "An adapted process A with A_0=0 whose paths are right-continuous and nondecreasing, of finite variation on compacts."
    },
    {
      "id": "s_cross_variation_M_N",
      "kind": "state",
      "name": "Cross-Variation <M,N>",
      "type_signature": "",
      "description": "For continuous local martingales M,N the unique continuous adapted finite-variation process <M,N>=(1/4)(<M+N>-<M-N>) making MN-<M,N> a local martingale."
    },
    {
      "id": "s_quadratic_variation_as_limit_of_sums",
      "kind": "theorem",
      "name": "Quadratic Variation as Limit of Sums",
      "type_signature": "",
      "description": "For a continuous local martingale M, the sums Σ(M_{t_{i+1}}-M_{t_i})^2 over partitions converge in probability, as the mesh tends to zero, to the quadratic variation <M>_t."
    },
    {
      "id": "t_levy_ciesielski_construction",
      "kind": "technique",
      "name": "Lévy–Ciesielski Construction of Brownian Motion",
      "function_signature": "(iid N(0,1) coefficients, Haar/Schauder basis) → (continuous Brownian path on [0,1])",
      "description": "A construction of Brownian motion as the uniformly convergent series Σ ξ_n S_n(t) of Schauder functions S_n with independent standard Gaussian coefficients ξ_n."
    },
    {
      "id": "s_haar_schauder_functions",
      "kind": "axiom",
      "name": "Haar and Schauder Functions",
      "type_signature": "",
      "description": "The orthonormal Haar wavelet system on [0,1] together with its integrals, the triangular Schauder functions, forming a basis used in the Lévy–Ciesielski construction."
    },
    {
      "id": "s_brownian_transition_semigroup",
      "kind": "state",
      "name": "Brownian (Heat) Transition Semigroup",
      "type_signature": "",
      "description": "The Markov semigroup (P_t f)(x)=∫ p_t(x,y)f(y)dy with Gaussian kernel p_t(x,y)=(2πt)^{-n/2}exp(-|x-y|^2/2t), the transition semigroup of Brownian motion solving the heat equation."
    },
    {
      "id": "s_gaussian_heat_kernel",
      "kind": "state",
      "name": "Gaussian Heat Kernel / Transition Density",
      "type_signature": "",
      "description": "The function p_t(x,y)=(2πt)^{-n/2}exp(-|x-y|^2/(2t)), the fundamental solution of the heat equation and the transition density of n-dimensional Brownian motion."
    },
    {
      "id": "s_augmented_brownian_filtration",
      "kind": "axiom",
      "name": "Augmented Brownian Filtration",
      "type_signature": "",
      "description": "The filtration generated by Brownian motion completed with all P-null sets and made right-continuous, satisfying the usual conditions."
    },
    {
      "id": "s_first_passage_time_T_a_distribution",
      "kind": "theorem",
      "name": "Distribution of Brownian First Passage Time T_a",
      "type_signature": "",
      "description": "For standard Brownian motion the first passage time T_a=inf{t:B_t=a} has the stable(1/2) density (|a|/√(2πt^3))exp(-a^2/2t) with Laplace transform E[e^{-λT_a}]=exp(-|a|√(2λ))."
    },
    {
      "id": "s_T_a_finite_infinite_expectation",
      "kind": "theorem",
      "name": "Brownian Hitting Time is Finite a.s. with Infinite Mean",
      "type_signature": "",
      "description": "For one-dimensional Brownian motion T_a<infinity almost surely for every level a, yet E[T_a]=infinity."
    },
    {
      "id": "s_law_of_iterated_logarithm_bm",
      "kind": "theorem",
      "name": "Law of the Iterated Logarithm for Brownian Motion",
      "type_signature": "",
      "description": "For standard Brownian motion, limsup_{t->0+} B_t/√(2t log log(1/t))=1 a.s. and the corresponding statement holds as t->infinity with √(2t log log t)."
    },
    {
      "id": "s_unbounded_variation_bm_paths",
      "kind": "theorem",
      "name": "Unbounded Total Variation of Brownian Paths",
      "type_signature": "",
      "description": "Almost every Brownian path has infinite total variation on every nondegenerate time interval, while having finite quadratic variation."
    },
    {
      "id": "s_markov_family",
      "kind": "axiom",
      "name": "Markov Family / Transition Function",
      "type_signature": "",
      "description": "A family of probability measures (P^x) on path space together with a transition function P(s,x,t,·) such that the process is Markov under each P^x started at x."
    },
    {
      "id": "s_feller_implies_strong_markov",
      "kind": "theorem",
      "name": "Feller Family is Strong Markov",
      "type_signature": "",
      "description": "A Markov family whose transition semigroup has the Feller property (with a right-continuous realization) is automatically a strong Markov family."
    },
    {
      "id": "t_wald_exponential_martingale_technique",
      "kind": "technique",
      "name": "Exponential (Wald) Martingale and Wald Identities",
      "function_signature": "(Brownian motion B, parameters λ,μ) → (martingale exp(λB_t-λ^2 t/2) and identities for E[T],E[B_T^2])",
      "description": "The technique of using exp(λB_t-λ^2t/2) and B_t, B_t^2-t as martingales together with optional sampling to derive Wald-type identities for stopping times."
    },
    {
      "id": "s_b_squared_minus_t_martingale",
      "kind": "theorem",
      "name": "B_t^2 - t is a Martingale",
      "type_signature": "",
      "description": "For standard Brownian motion the process B_t^2 - t is a martingale, and more generally f(B_t)-(1/2)∫f''(B_s)ds is a martingale for suitable f."
    },
    {
      "id": "s_space_of_simple_processes",
      "kind": "axiom",
      "name": "Space of Simple / Elementary Processes",
      "type_signature": "",
      "description": "The space of processes of the form H_t=Σ ξ_i 1_{(t_i,t_{i+1}]}(t) with ξ_i bounded and F_{t_i}-measurable, dense in the L^2 space of progressively measurable integrands."
    },
    {
      "id": "t_ito_integral_simple_processes",
      "kind": "technique",
      "name": "Itô Integral Construction for Simple Processes",
      "function_signature": "(simple process H, martingale M) → (elementary stochastic integral Σ ξ_i (M_{t_{i+1}}-M_{t_i}))",
      "description": "The definition of the stochastic integral of a simple integrand as the finite martingale transform sum Σ ξ_i (M_{t_{i+1}∧t}-M_{t_i∧t})."
    },
    {
      "id": "t_isometric_extension_ito_integral",
      "kind": "technique",
      "name": "Extension of the Itô Integral by Isometry",
      "function_signature": "(L^2-Cauchy sequence of simple integrals) → (stochastic integral of general L^2 integrand)",
      "description": "The extension of the stochastic integral from simple integrands to all progressively measurable L^2 integrands by completion using the Itô isometry."
    },
    {
      "id": "s_stochastic_integral_is_continuous_L2_martingale",
      "kind": "theorem",
      "name": "Stochastic Integral is a Continuous L^2 Martingale",
      "type_signature": "",
      "description": "For an L^2 integrand against a continuous L^2 martingale, the Itô integral (∫H dM)_t is itself a continuous square-integrable martingale null at zero."
    },
    {
      "id": "s_quadratic_variation_of_stochastic_integral",
      "kind": "theorem",
      "name": "Quadratic Variation of the Stochastic Integral",
      "type_signature": "",
      "description": "The quadratic variation of the stochastic integral I=∫H dM is <I>_t=∫_0^t H_s^2 d<M>_s, and the cross-variation of ∫H dM and ∫K dN is ∫ H_s K_s d<M,N>_s."
    },
    {
      "id": "s_localization_of_quadratic_variation",
      "kind": "theorem",
      "name": "Localization of Quadratic Variation",
      "type_signature": "",
      "description": "Every continuous local martingale M admits a unique continuous increasing adapted process <M> with <M>_0=0 such that M^2-<M> is a local martingale, obtained by localizing the L^2 theory."
    },
    {
      "id": "s_associativity_of_stochastic_integral",
      "kind": "theorem",
      "name": "Associativity of the Stochastic Integral",
      "type_signature": "",
      "description": "If N=∫H dM then ∫K dN=∫KH dM, i.e. integrating against a stochastic integral equals integrating against the product integrand."
    },
    {
      "id": "s_ito_formula_one_dimensional",
      "kind": "theorem",
      "name": "Itô Formula (One-Dimensional)",
      "type_signature": "",
      "description": "For f in C^2 and a continuous semimartingale X, f(X_t)=f(X_0)+∫f'(X_s)dX_s+(1/2)∫f''(X_s)d<X>_s."
    },
    {
      "id": "s_ito_formula_multidimensional",
      "kind": "theorem",
      "name": "Itô Formula (Multidimensional)",
      "type_signature": "",
      "description": "For f in C^2(R^n) and a vector continuous semimartingale X, f(X_t)=f(X_0)+Σ∫∂_i f dX^i_s+(1/2)ΣΣ∫∂_{ij}f d<X^i,X^j>_s."
    },
    {
      "id": "s_ito_formula_time_dependent",
      "kind": "theorem",
      "name": "Itô Formula for Time-Dependent C^{1,2} Functions",
      "type_signature": "",
      "description": "For f(t,x) in C^{1,2} and a continuous semimartingale X, f(t,X_t)=f(0,X_0)+∫∂_t f ds+∫∂_x f dX_s+(1/2)∫∂_{xx}f d<X>_s."
    },
    {
      "id": "s_kazamaki_condition",
      "kind": "theorem",
      "name": "Kazamaki Condition",
      "type_signature": "",
      "description": "If the exponential exp(M_t/2) of a continuous local martingale M is a uniformly integrable submartingale, then the Doléans–Dade exponential E(M) is a uniformly integrable martingale."
    },
    {
      "id": "s_girsanov_transformation_local_martingales",
      "kind": "theorem",
      "name": "Girsanov Transformation of Local Martingales",
      "type_signature": "",
      "description": "Under the measure change dQ=E(N)_T dP, a P-local martingale M becomes the Q-semimartingale M-<M,N>, so M-<M,N> is a Q-local martingale."
    },
    {
      "id": "s_knight_theorem_multidim_time_change",
      "kind": "theorem",
      "name": "Knight's Multidimensional Time-Change Theorem",
      "type_signature": "",
      "description": "Orthogonal continuous local martingales, when each is time-changed by the inverse of its own quadratic variation, become independent standard Brownian motions."
    },
    {
      "id": "s_harmonic_function_of_bm_is_local_martingale",
      "kind": "theorem",
      "name": "Harmonic Function of Brownian Motion is a Local Martingale",
      "type_signature": "",
      "description": "If h is harmonic on a domain D and B is Brownian motion, then h(B_{t∧τ_D}) is a continuous local martingale up to the exit time τ_D of D."
    },
    {
      "id": "s_probabilistic_mean_value_property",
      "kind": "theorem",
      "name": "Probabilistic Mean Value Property",
      "type_signature": "",
      "description": "For h harmonic on D, h(x)=E^x[h(B_{τ})] for the exit time τ from any ball (or relatively compact subdomain) centered at x, expressing the mean value property via Brownian motion."
    },
    {
      "id": "s_dirichlet_problem",
      "kind": "axiom",
      "name": "Dirichlet Problem",
      "type_signature": "",
      "description": "The boundary value problem of finding a function harmonic in a domain D and equal to prescribed continuous boundary data f on ∂D."
    },
    {
      "id": "s_stochastic_solution_of_dirichlet_problem",
      "kind": "theorem",
      "name": "Stochastic Solution of the Dirichlet Problem",
      "type_signature": "",
      "description": "If every boundary point of D is regular then u(x)=E^x[f(B_{τ_D})] is the unique bounded harmonic function on D with boundary values f, solving the Dirichlet problem."
    },
    {
      "id": "t_exterior_cone_zaremba_condition",
      "kind": "technique",
      "name": "Exterior Cone (Zaremba) Condition",
      "function_signature": "(boundary point z, truncated exterior cone at z) → (regularity of z)",
      "description": "The technique establishing regularity of a boundary point by exhibiting a nondegenerate truncated cone in the complement with vertex at that point."
    },
    {
      "id": "s_harmonic_measure_exit_distribution",
      "kind": "state",
      "name": "Harmonic Measure / Exit Distribution",
      "type_signature": "",
      "description": "The probability measure μ_x(A)=P^x(B_{τ_D} in A) on ∂D giving the distribution of the Brownian exit position from D started at x, against which harmonic functions reproduce their boundary values."
    },
    {
      "id": "s_poisson_kernel_exit_distribution_ball",
      "kind": "theorem",
      "name": "Poisson Kernel Exit Distribution on a Ball",
      "type_signature": "",
      "description": "The Brownian exit distribution from a ball B(0,r) started at x has density (r^2-|x|^2)/(σ_r |y-x|^n) on the sphere, the Poisson kernel of the ball."
    },
    {
      "id": "s_polarity_of_points_and_sets",
      "kind": "theorem",
      "name": "Polarity of Points and Sets for Brownian Motion",
      "type_signature": "",
      "description": "For Brownian motion in dimension n>=2 single points are polar (never hit by the path from a distinct start), and more generally sets of zero capacity are polar."
    },
    {
      "id": "s_hitting_probabilities_annulus_exit",
      "kind": "theorem",
      "name": "Hitting Probabilities and Annulus Exit",
      "type_signature": "",
      "description": "For Brownian motion the probability of hitting the inner sphere before the outer sphere of an annulus is given explicitly via the harmonic function log|x| (n=2) or |x|^{2-n} (n>=3)."
    },
    {
      "id": "s_poisson_equation_probabilistic_solution",
      "kind": "theorem",
      "name": "Probabilistic Solution of the Poisson Equation",
      "type_signature": "",
      "description": "The solution of (1/2)Δu=-g in D with zero boundary data is u(x)=E^x[∫_0^{τ_D} g(B_s)ds]=∫_D G_D(x,y)g(y)dy."
    },
    {
      "id": "s_kac_formula_brownian_functionals",
      "kind": "theorem",
      "name": "Kac Formula for Brownian Functionals",
      "type_signature": "",
      "description": "The Laplace transform in space of the expected exponential functional E^x[exp(-∫_0^τ V(B_s)ds)] solves a Sturm–Liouville eigenvalue equation, giving distributions of additive Brownian functionals."
    },
    {
      "id": "s_heat_equation_probabilistic_solution",
      "kind": "theorem",
      "name": "Probabilistic Solution of the Cauchy Heat Problem",
      "type_signature": "",
      "description": "The bounded solution of the Cauchy problem ∂_t u=(1/2)Δu, u(0,·)=f is u(t,x)=E^x[f(B_t)]=∫ p_t(x,y)f(y)dy."
    },
    {
      "id": "s_cauchy_problem_uniqueness_tychonoff",
      "kind": "theorem",
      "name": "Tychonoff Uniqueness for the Cauchy Problem",
      "type_signature": "",
      "description": "The Cauchy problem for the heat equation has a unique solution within the class of functions of at most exponential quadratic growth (the Tychonoff growth condition)."
    },
    {
      "id": "t_sturm_liouville_green_function",
      "kind": "technique",
      "name": "Sturm–Liouville Green's Function",
      "function_signature": "(scale function, speed measure, boundary data) → (Green's function of the 1-D generator)",
      "description": "The construction of the Green's function of a one-dimensional diffusion generator from increasing and decreasing solutions of the associated Sturm–Liouville equation."
    },
    {
      "id": "s_expected_exit_time_solves_poisson",
      "kind": "theorem",
      "name": "Expected Exit Time Solves the Poisson Equation",
      "type_signature": "",
      "description": "The mean exit time v(x)=E^x[τ_D] of Brownian motion from D is the solution of (1/2)Δv=-1 in D with v=0 on ∂D."
    },
    {
      "id": "s_probabilistic_maximum_principle",
      "kind": "theorem",
      "name": "Probabilistic Maximum Principle",
      "type_signature": "",
      "description": "A function that is subharmonic (Lu>=0 for the diffusion generator L) attains its maximum on the boundary, derived from the submartingale property of u(X_t)."
    },
    {
      "id": "s_strong_solution_of_sde",
      "kind": "axiom",
      "name": "Strong Solution of an SDE",
      "type_signature": "",
      "description": "A process X adapted to the augmented filtration of a given Brownian motion W on a given probability space that satisfies dX_t=b(t,X_t)dt+σ(t,X_t)dW_t pathwise."
    },
    {
      "id": "s_weak_solution_of_sde",
      "kind": "axiom",
      "name": "Weak Solution of an SDE",
      "type_signature": "",
      "description": "A triple consisting of a filtered probability space, a Brownian motion W, and a process X on it satisfying the SDE, where the driving Brownian motion is part of the solution rather than prescribed."
    },
    {
      "id": "s_pathwise_uniqueness",
      "kind": "axiom",
      "name": "Pathwise Uniqueness",
      "type_signature": "",
      "description": "The property that any two solutions of an SDE driven by the same Brownian motion on the same space with the same initial condition are indistinguishable."
    },
    {
      "id": "s_uniqueness_in_law",
      "kind": "axiom",
      "name": "Uniqueness in Law / Distribution",
      "type_signature": "",
      "description": "The property that any two weak solutions of an SDE with the same initial distribution induce the same law on path space."
    },
    {
      "id": "s_ito_existence_uniqueness_theorem",
      "kind": "theorem",
      "name": "Itô Existence–Uniqueness Theorem",
      "type_signature": "",
      "description": "Under global Lipschitz and linear-growth conditions on the coefficients, the SDE has a unique strong solution that is a square-integrable continuous process."
    },
    {
      "id": "t_picard_iteration_sde",
      "kind": "technique",
      "name": "Picard Iteration for SDEs",
      "function_signature": "(coefficients b,σ, initial X^0) → (successive approximations X^{n+1}=X_0+∫b(X^n)ds+∫σ(X^n)dW converging to the solution)",
      "description": "The successive-approximation scheme that constructs the strong solution of a Lipschitz SDE as the limit of iterates X^{n+1}_t=X_0+∫b(s,X^n_s)ds+∫σ(s,X^n_s)dW_s."
    },
    {
      "id": "s_a_priori_moment_estimates_sde",
      "kind": "theorem",
      "name": "A Priori Moment Estimates and Continuity in Initial Data",
      "type_signature": "",
      "description": "Solutions of Lipschitz/linear-growth SDEs satisfy E[sup_{s<=t}|X_s|^{2p}]<=C(1+|x|^{2p})e^{Ct} and depend continuously, in L^{2p}, on the initial condition."
    },
    {
      "id": "s_yamada_watanabe_theorem",
      "kind": "theorem",
      "name": "Yamada–Watanabe Theorem",
      "type_signature": "",
      "description": "Weak existence together with pathwise uniqueness implies existence of a strong solution and uniqueness in law for the SDE."
    },
    {
      "id": "s_yamada_watanabe_pathwise_condition",
      "kind": "theorem",
      "name": "Yamada–Watanabe One-Dimensional Pathwise Uniqueness Condition",
      "type_signature": "",
      "description": "For a one-dimensional SDE, pathwise uniqueness holds if the diffusion coefficient satisfies |σ(x)-σ(y)|<=ρ(|x-y|) with ∫_{0+}ρ^{-2}=infinity (e.g. Hölder-1/2) and the drift is Lipschitz."
    },
    {
      "id": "s_equivalence_weak_solutions_martingale_problem",
      "kind": "theorem",
      "name": "Equivalence of Weak Solutions and the Martingale Problem",
      "type_signature": "",
      "description": "A weak solution of an SDE with coefficients (b,σ) exists if and only if the Stroock–Varadhan martingale problem for the generator L=(1/2)Σa_{ij}∂_{ij}+Σb_i∂_i is solvable, with a=σσ^T."
    },
    {
      "id": "s_markov_property_of_sde_solutions",
      "kind": "theorem",
      "name": "Markov Property of SDE Solutions",
      "type_signature": "",
      "description": "Under uniqueness, the solution of an SDE with time-homogeneous coefficients is a Markov family with transition function determined by the law of the solution started at each point."
    },
    {
      "id": "s_strong_markov_property_of_sde_solutions",
      "kind": "theorem",
      "name": "Strong Markov Property of SDE Solutions",
      "type_signature": "",
      "description": "Under uniqueness in law, the solution of a time-homogeneous SDE is a strong Markov process, satisfying the Markov property at stopping times."
    },
    {
      "id": "s_comparison_theorem_1d_sde",
      "kind": "theorem",
      "name": "Comparison Theorem for One-Dimensional SDEs",
      "type_signature": "",
      "description": "For two one-dimensional SDEs with the same diffusion coefficient and ordered drifts and initial conditions, the corresponding solutions remain pathwise ordered for all time."
    },
    {
      "id": "s_ornstein_uhlenbeck_process",
      "kind": "state",
      "name": "Ornstein–Uhlenbeck Process",
      "type_signature": "",
      "description": "The solution of the linear SDE dX_t=-θX_t dt+σ dW_t, a stationary Gaussian Markov diffusion mean-reverting to zero with exponential covariance."
    },
    {
      "id": "s_linear_sde_solution",
      "kind": "theorem",
      "name": "Linear SDEs",
      "type_signature": "",
      "description": "The linear SDE dX_t=(A(t)X_t+a(t))dt+Σ(C_i(t)X_t+c_i(t))dW^i_t has an explicit solution via a matrix fundamental solution and variation of constants, with Gaussian law when the multiplicative noise terms vanish."
    },
    {
      "id": "s_bessel_process",
      "kind": "state",
      "name": "Bessel Process",
      "type_signature": "",
      "description": "The radial part R_t=|B_t| of n-dimensional Brownian motion, equivalently the solution of dR_t=dβ_t+((δ-1)/(2R_t))dt of dimension δ, a nonnegative diffusion."
    },
    {
      "id": "t_girsanov_weak_solution_construction",
      "kind": "technique",
      "name": "Girsanov-Based Weak Solution Construction",
      "function_signature": "(bounded measurable drift b, Brownian motion under P) → (weak solution under Q=E(∫b dW)·P)",
      "description": "The construction of a weak solution of an SDE with bounded measurable drift by changing measure via the Girsanov density to absorb the drift into a new Brownian motion."
    },
    {
      "id": "s_cameron_martin_formula",
      "kind": "theorem",
      "name": "Cameron–Martin Formula",
      "type_signature": "",
      "description": "Translating Wiener measure by an absolutely continuous path h with h'∈L^2 yields a measure equivalent to Wiener measure with density exp(∫h' dB-(1/2)∫|h'|^2 ds)."
    },
    {
      "id": "s_tanaka_example_weak_no_strong",
      "kind": "state",
      "name": "Tanaka's Example (Weak but No Strong Solution)",
      "type_signature": "",
      "description": "The SDE dX_t=sgn(X_t)dW_t, which possesses a weak solution and uniqueness in law but no strong solution and fails pathwise uniqueness."
    },
    {
      "id": "s_engelbert_schmidt_conditions",
      "kind": "theorem",
      "name": "Engelbert–Schmidt Conditions",
      "type_signature": "",
      "description": "For the driftless one-dimensional SDE dX_t=σ(X_t)dW_t, a weak solution exists if 1/σ^2 is locally integrable, and uniqueness in law holds under the additional non-degeneracy of σ."
    },
    {
      "id": "s_engelbert_schmidt_zero_one_law",
      "kind": "theorem",
      "name": "Engelbert–Schmidt Zero-One Law",
      "type_signature": "",
      "description": "For a measurable f and Brownian motion, the additive functional ∫_0^t f(B_s)ds is either finite for all t a.s. or infinite for all t>0 a.s., according to the local integrability of f."
    },
    {
      "id": "t_time_change_construction_1d_sde",
      "kind": "technique",
      "name": "Time-Change Construction of a One-Dimensional SDE",
      "function_signature": "(Brownian motion, diffusion coefficient σ) → (weak solution as a time-changed Brownian motion)",
      "description": "The construction of a weak solution of dX=σ(X)dW by time-changing a Brownian motion using the inverse of the additive functional ∫σ^{-2}(B_s)ds."
    },
    {
      "id": "s_feller_test_for_explosions",
      "kind": "theorem",
      "name": "Feller's Test for Explosions",
      "type_signature": "",
      "description": "A criterion, in terms of the scale function and speed measure, deciding whether a one-dimensional diffusion reaches its boundary in finite time (explodes) with positive probability."
    },
    {
      "id": "s_explosion_time",
      "kind": "state",
      "name": "Explosion Time",
      "type_signature": "",
      "description": "The time e=lim τ_n at which a diffusion exits every compact subinterval, i.e. reaches the boundary of its state space or diverges to infinity."
    },
    {
      "id": "s_stroock_varadhan_support_theorem",
      "kind": "theorem",
      "name": "Stroock–Varadhan Support Theorem",
      "type_signature": "",
      "description": "The topological support of the law of a nondegenerate diffusion in path space is the closure of the set of solutions of the associated control (ODE) system obtained by replacing the noise with smooth controls."
    },
    {
      "id": "t_wong_zakai_stratonovich_correction",
      "kind": "technique",
      "name": "Wong–Zakai / Stratonovich Correction",
      "function_signature": "(piecewise-linear approximations of Brownian motion) → (Stratonovich SDE limit with drift correction)",
      "description": "The technique whereby ODEs driven by smooth approximations of Brownian motion converge to the Stratonovich SDE, differing from the Itô equation by the correction drift (1/2)σσ'."
    },
    {
      "id": "s_weak_existence_skorokhod",
      "kind": "theorem",
      "name": "Weak Existence under Bounded Continuous Coefficients (Skorokhod)",
      "type_signature": "",
      "description": "An SDE with bounded continuous coefficients and nondegenerate diffusion admits a weak solution, constructed by tightness and the Skorokhod representation of approximating Euler solutions."
    },
    {
      "id": "s_uniqueness_in_law_via_martingale_problem",
      "kind": "theorem",
      "name": "Uniqueness in Law via Martingale Problem Well-Posedness",
      "type_signature": "",
      "description": "Uniqueness in law for an SDE is equivalent to well-posedness (existence and uniqueness) of the corresponding Stroock–Varadhan martingale problem for its generator."
    },
    {
      "id": "s_tanaka_formula_positive_part",
      "kind": "theorem",
      "name": "Tanaka Formulas for (X-a)^+ and (X-a)^-",
      "type_signature": "",
      "description": "For a continuous semimartingale X, (X_t-a)^+=(X_0-a)^+ +∫1_{X_s>a}dX_s+(1/2)L_t^a and (X_t-a)^- = (X_0-a)^- -∫1_{X_s<=a}dX_s+(1/2)L_t^a, where L^a is the local time at level a."
    },
    {
      "id": "s_trotter_joint_continuity_local_time",
      "kind": "theorem",
      "name": "Trotter's Joint Continuity of Local Time",
      "type_signature": "",
      "description": "The local time L_t^a of Brownian motion admits a modification that is jointly continuous in (t,a), and continuous in t and càdlàg in a for general continuous semimartingales."
    },
    {
      "id": "s_levy_theorem_local_time",
      "kind": "theorem",
      "name": "Lévy's Theorem on Local Time",
      "type_signature": "",
      "description": "The pair (|B_t|, L_t^0) of reflected Brownian motion and its local time at zero has the same law as (M_t-B_t, M_t), where M_t=max_{s<=t}B_s is the running maximum."
    },
    {
      "id": "s_skorokhod_reflection_problem",
      "kind": "theorem",
      "name": "Skorokhod Reflection Problem",
      "type_signature": "",
      "description": "Given a continuous path y with y_0>=0, there exist unique continuous processes (x,k) with x=y+k>=0, k nondecreasing with k_0=0, and k increasing only when x=0; x is the reflection of y at zero."
    },
    {
      "id": "s_skorokhod_lemma_explicit_formula",
      "kind": "theorem",
      "name": "Skorokhod Lemma (Explicit Formula)",
      "type_signature": "",
      "description": "The regulator solving the reflection problem is given explicitly by k_t=max_{s<=t}(-y_s)^+=sup_{s<=t}(0∨(-y_s)), and the reflected path is x_t=y_t+k_t."
    },
    {
      "id": "s_reflected_brownian_motion",
      "kind": "state",
      "name": "Reflected Brownian Motion",
      "type_signature": "",
      "description": "The nonnegative process |B_t|, equivalently the solution of the Skorokhod reflection problem driven by Brownian motion, a Markov diffusion reflecting instantaneously at zero."
    },
    {
      "id": "s_downcrossing_representation_local_time",
      "kind": "theorem",
      "name": "Downcrossing Representation of Local Time",
      "type_signature": "",
      "description": "Brownian local time at a level a equals the limit, as ε->0, of ε times the number of downcrossings (or upcrossings) of the interval (a,a+ε) by the path up to time t."
    },
    {
      "id": "s_first_ray_knight_theorem",
      "kind": "theorem",
      "name": "First Ray–Knight Theorem",
      "type_signature": "",
      "description": "For Brownian motion stopped at the first hitting time of level 1, the family of local times {L_{T_1}^{1-a}}_{0<=a<=1} as a process in the space variable is a squared Bessel process of dimension 2."
    },
    {
      "id": "s_second_ray_knight_theorem",
      "kind": "theorem",
      "name": "Second Ray–Knight Theorem",
      "type_signature": "",
      "description": "For Brownian motion run until the inverse local time at zero reaches level t, the local-time field in the space variable is a squared Bessel process of dimension 0 started at t."
    },
    {
      "id": "s_joint_distribution_B_and_local_time",
      "kind": "theorem",
      "name": "Joint Distribution of (B_t, L_t^0)",
      "type_signature": "",
      "description": "The pair (B_t,L_t^0) of Brownian motion and its local time at zero has an explicit joint density obtainable from the reflection principle and Lévy's theorem."
    },
    {
      "id": "s_inverse_local_time_stable_subordinator",
      "kind": "theorem",
      "name": "Inverse Local Time as a Stable Subordinator",
      "type_signature": "",
      "description": "The right-continuous inverse τ_ℓ=inf{t:L_t^0>ℓ} of Brownian local time at zero is a stable subordinator of index 1/2 with no drift."
    },
    {
      "id": "t_ito_excursion_theory",
      "kind": "technique",
      "name": "Itô Excursion Theory / Excursion Measure",
      "function_signature": "(Brownian motion, local time clock) → (Poisson point process of excursions with Itô excursion measure)",
      "description": "The description of the excursions of Brownian motion away from zero, indexed by local time, as a Poisson point process governed by the σ-finite Itô excursion measure."
    },
    {
      "id": "s_continuity_of_local_time_support",
      "kind": "theorem",
      "name": "Continuity and Support Property of Local Time",
      "type_signature": "",
      "description": "The local time L^a_t is supported on the closure of the zero set {s:X_s=a}, i.e. dL^a_s is carried by the times when X_s=a, and is jointly continuous for Brownian motion."
    },
    {
      "id": "t_local_time_via_dds",
      "kind": "technique",
      "name": "Local Time of a Continuous Local Martingale via DDS",
      "function_signature": "(continuous local martingale M=B_{<M>}) → (local time of M from Brownian local time under Dambis–Dubins–Schwarz time change)",
      "description": "The technique of obtaining the local time of a continuous local martingale by transporting Brownian local time through the Dambis–Dubins–Schwarz time change M_t=B_{<M>_t}."
    }
