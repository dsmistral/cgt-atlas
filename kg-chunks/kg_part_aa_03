    },
    {
      "id": "s_bv_functions_differentiable_ae",
      "kind": "theorem",
      "name": "BV functions are differentiable a.e.",
      "type_signature": "",
      "description": "Every function of bounded variation on [a,b] is differentiable Lebesgue-almost everywhere."
    },
    {
      "id": "s_singular_function",
      "kind": "axiom",
      "name": "Singular function",
      "type_signature": "",
      "description": "A nondecreasing continuous function F on [a,b] whose derivative F'(x) = 0 for Lebesgue-a.e. x, yet F is not constant."
    },
    {
      "id": "s_decomposition_bv_functions",
      "kind": "theorem",
      "name": "Decomposition of BV functions",
      "type_signature": "",
      "description": "Every BV function on [a,b] can be uniquely decomposed as f = f_ac + f_s + f_j where f_ac is absolutely continuous, f_s is singular continuous, and f_j is a jump function."
    },
    {
      "id": "s_integration_by_parts_ac",
      "kind": "theorem",
      "name": "Integration by parts for absolutely continuous functions",
      "type_signature": "",
      "description": "If F and G are absolutely continuous on [a,b], then ∫_a^b F'G dx = F(b)G(b) - F(a)G(a) - ∫_a^b FG' dx."
    },
    {
      "id": "s_lebesgue_radon_nikodym_on_R",
      "kind": "theorem",
      "name": "Lebesgue-Radon-Nikodym theorem on ℝ",
      "type_signature": "",
      "description": "Every BV function F decomposes as F = F_ac + F_s where F_ac is absolutely continuous and F_s' = 0 a.e., corresponding to the Lebesgue decomposition of μ_F."
    },
    {
      "id": "s_net_convergence",
      "kind": "axiom",
      "name": "Net (generalized sequence)",
      "type_signature": "",
      "description": "A function from a directed set (I, ≤) to a topological space X; a net (x_α) converges to x if for every open U containing x there exists α₀ with x_α ∈ U for all α ≥ α₀."
    },
    {
      "id": "s_subnet",
