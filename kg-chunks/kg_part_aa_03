      "type_signature": "",
      "description": "A function p: X → [0,∞) on a vector space satisfying p(αx) = |α|p(x) and p(x+y) ≤ p(x) + p(y), but possibly p(x) = 0 for x ≠ 0."
    },
    {
      "id": "s_bounded_linear_operator",
      "kind": "axiom",
      "name": "Bounded linear operator",
      "type_signature": "",
      "description": "A linear map T: X → Y between normed spaces such that ||T|| = sup{||Tx|| : ||x|| ≤ 1} < ∞, equivalently a continuous linear map."
