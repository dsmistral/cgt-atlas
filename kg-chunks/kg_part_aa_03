    {
      "id": "s_borel_sigma_algebra_on_Rn",
      "kind": "axiom",
      "name": "Borel σ-algebra on ℝⁿ",
      "type_signature": "σ(O(ℝⁿ))",
      "description": "The σ-algebra on ℝⁿ generated by the open sets in the product topology, equivalently by the open rectangles or the coordinate projections."
    },
    {
      "id": "s_random_vector",
      "kind": "axiom",
      "name": "Random vector",
      "type_signature": "(Ω, F, P) → (ℝⁿ, B(ℝⁿ))",
      "description": "A measurable function X: (Ω, F) → (ℝⁿ, B(ℝⁿ)), equivalently an n-tuple of real-valued random variables."
    },
    {
