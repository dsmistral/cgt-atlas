    },
    {
      "id": "s_separation_of_points_by_functionals",
      "kind": "theorem",
      "name": "Separation of points by continuous linear functionals",
      "type_signature": "",
      "description": "For any x ≠ 0 in a normed space X, there exists f ∈ X* with f(x) ≠ 0 and ||f|| = 1, ||f(x)|| = ||x||."
    },
    {
      "id": "s_second_category_set",
      "kind": "axiom",
      "name": "Second category set (non-meager set)",
      "type_signature": "",
      "description": "A subset of a topological space that is not a countable union of nowhere dense sets."
    },
    {
      "id": "s_banach_steinhaus_pointwise_convergence",
      "kind": "theorem",
      "name": "Banach-Steinhaus theorem (pointwise convergence corollary)",
      "type_signature": "",
      "description": "If T_n ∈ B(X,Y) with X Banach and T_n(x) converges for each x ∈ X, then sup_n ||T_n|| < ∞ and the pointwise limit T is in B(X,Y) with ||T|| ≤ lim inf ||T_n||."
    },
    {
      "id": "s_bounded_inverse_theorem",
      "kind": "theorem",
      "name": "Bounded inverse theorem",
      "type_signature": "",
      "description": "If T: X → Y is a bounded bijective linear operator between Banach spaces, then T⁻¹ is also bounded."
    },
    {
      "id": "s_weak_topology_on_normed_space",
      "kind": "axiom",
      "name": "Weak topology on a normed space",
      "type_signature": "",
      "description": "The coarsest topology on a normed space X making every f ∈ X* continuous; x_α → x weakly iff f(x_α) → f(x) for all f ∈ X*."
    },
    {
      "id": "s_closest_point_convex_set",
      "kind": "theorem",
      "name": "Closest point to a closed convex set in Hilbert space",
      "type_signature": "",
