    },
    {
      "id": "s_topological_vector_space",
      "kind": "axiom",
      "name": "Topological vector space (TVS)",
      "type_signature": "",
      "description": "A vector space X over ℝ or ℂ equipped with a topology making addition and scalar multiplication continuous."
    },
    {
