    },
    {
      "id": "s_C0_space",
      "kind": "axiom",
      "name": "C₀(X) — continuous functions vanishing at infinity",
      "type_signature": "",
      "description": "The Banach space of continuous functions f on a locally compact Hausdorff space X such that {x : |f(x)| ≥ ε} is compact for every ε > 0, with the sup norm."
    },
    {
      "id": "s_lusin_theorem_radon",
      "kind": "theorem",
      "name": "Lusin's theorem for Radon measures",
      "type_signature": "",
      "description": "If μ is a Radon measure on a LCH space X and f is measurable, then for every ε > 0 there exists a compact K with μ(K^c) < ε such that f|_K is continuous."
    },
    {
      "id": "s_dual_of_C0",
      "kind": "theorem",
      "name": "Dual of C₀(X)",
      "type_signature": "",
      "description": "The dual space C₀(X)* is isometrically isomorphic to the space M(X) of complex Radon measures on X, via the pairing I(f) = ∫f dμ."
    },
    {
      "id": "s_approximate_identity_Rn",
      "kind": "state",
      "name": "Approximate identity on ℝⁿ",
