    },
    {
      "id": "s_singular_support",
      "kind": "state",
      "name": "Singular support of a distribution",
      "type_signature": "u ∈ D'(Ω) → sing supp(u) ⊂ Ω closed",
      "description": "The complement of the largest open set on which the distribution u agrees with a smooth function."
    },
    {
      "id": "s_fourier_transform_tempered_distributions",
      "kind": "state",
      "name": "Fourier transform of tempered distributions",
      "type_signature": "S'(ℝⁿ) → S'(ℝⁿ) automorphism",
