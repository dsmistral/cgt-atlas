    },
    {
      "id": "s_quotient_normed_space",
      "kind": "state",
      "name": "Quotient normed space",
      "type_signature": "Normed space X, closed subspace M → X/M with quotient norm",
      "description": "For a closed subspace M of a normed space X, the quotient X/M with norm ||x + M|| = inf{||x + m|| : m ∈ M} is a normed space; it is Banach when X is."
    },
    {
      "id": "s_chebyshev_markov_Lp",
      "kind": "theorem",
      "name": "Chebyshev-Markov inequality for Lp",
      "type_signature": "",
      "description": "For f ∈ Lp and α > 0, μ({x : |f(x)| > α}) ≤ α⁻ᵖ ||f||_p^p."
    },
    {
      "id": "s_lp_inclusions_finite_measure",
      "kind": "theorem",
      "name": "Lp inclusions under finite measure",
      "type_signature": "",
      "description": "If μ(X) < ∞ and 1 ≤ p ≤ q ≤ ∞, then Lq(μ) ⊂ Lp(μ) with ||f||_p ≤ μ(X)^{1/p - 1/q} ||f||_q."
    },
    {
      "id": "s_dual_of_Lp",
      "kind": "theorem",
      "name": "Dual of Lp",
      "type_signature": "",
      "description": "For 1 ≤ p < ∞ and σ-finite μ, the dual (Lp)* is isometrically isomorphic to Lq where 1/p + 1/q = 1, via the pairing ⟨f, g⟩ = ∫fg dμ."
    },
    {
      "id": "s_minkowski_integral_inequality",
      "kind": "theorem",
      "name": "Minkowski's inequality for integrals",
      "type_signature": "",
      "description": "For 1 ≤ p < ∞ and nonneg measurable F on X × Y, (∫_X (∫_Y F(x,y) dν(y))^p dμ(x))^{1/p} ≤ ∫_Y (∫_X F(x,y)^p dμ(x))^{1/p} dν(y)."
    },
    {
      "id": "s_weak_Lp_space",
      "kind": "axiom",
      "name": "Weak Lp space",
      "type_signature": "",
      "description": "The space Lp,∞(μ) of measurable functions f with ||f||_{p,∞} = sup_{α>0} α·μ({|f| > α})^{1/p} < ∞, a quasi-normed space containing Lp."
    },
    {
      "id": "s_Cc_space",
      "kind": "axiom",
      "name": "Cc(X) — continuous functions with compact support",
      "type_signature": "",
