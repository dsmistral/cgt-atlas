      "name": "Every k-cell is compact",
      "type_signature": "",
      "description": "Every closed k-cell [a1,b1] x ... x [ak,bk] in R^k is compact."
    },
    {
      "id": "s_compact_metric_is_separable",
      "kind": "theorem",
      "name": "Compact metric space is separable",
      "type_signature": "",
      "description": "Every compact metric space has a countable dense subset and hence a countable base."
    },
    {
      "id": "s_connected_subsets_of_R_are_intervals",
      "kind": "theorem",
      "name": "Connected subsets of R are intervals",
      "type_signature": "",
      "description": "A subset E of R is connected if and only if for any x,y in E with x < z < y, z is in E."
    },
    {
      "id": "s_cantor_set",
      "kind": "state",
      "name": "Cantor set",
      "type_signature": "",
      "description": "The set obtained by iteratively removing open middle thirds from [0,1]; a perfect, compact, uncountable, nowhere dense set of measure zero."
    },
    {
      "id": "t_cantor_diagonalization",
      "kind": "technique",
      "name": "Cantor diagonalization technique",
      "function_signature": "(Assumed enumeration of a set) -> (Contradiction via constructing element not in enumeration)",
      "description": "Constructs an element differing from each listed element in its corresponding position, proving uncountability or non-surjectivity."
    },
    {
      "id": "t_nested_intervals",
      "kind": "technique",
      "name": "Nested intervals technique",
      "function_signature": "(Sequence of nested closed intervals with lengths tending to 0) -> (Unique point in intersection)",
      "description": "Uses the completeness of R to extract a limit point from a sequence of nested closed intervals whose lengths shrink to zero."
    },
    {
      "id": "s_convergent_sequence",
      "kind": "axiom",
      "name": "Convergent sequence in a metric space",
      "type_signature": "",
      "description": "A sequence {p_n} in a metric space (X,d) converges to p if for every epsilon > 0 there exists N such that d(p_n,p) < epsilon for all n >= N."
    },
    {
      "id": "s_subsequence",
      "kind": "axiom",
      "name": "Subsequence",
      "type_signature": "",
      "description": "A sequence {p_{n_k}} obtained from {p_n} by selecting terms along a strictly increasing sequence of indices n_1 < n_2 < ... ."
    },
    {
      "id": "s_subsequential_limit",
      "kind": "state",
      "name": "Subsequential limit",
      "type_signature": "",
      "description": "A point p such that some subsequence of a given sequence converges to p; the set of all subsequential limits is denoted E*."
    },
    {
      "id": "s_series_convergence",
      "kind": "axiom",
      "name": "Series convergence",
      "type_signature": "",
      "description": "A series sum a_n converges if the sequence of partial sums s_N = sum_{n=1}^{N} a_n converges; otherwise it diverges."
    },
    {
      "id": "s_absolute_convergence",
      "kind": "state",
      "name": "Absolute convergence",
      "type_signature": "",
      "description": "A series sum a_n converges absolutely if sum |a_n| converges; absolute convergence implies convergence."
    },
    {
      "id": "s_conditional_convergence",
      "kind": "state",
      "name": "Conditional convergence",
      "type_signature": "",
      "description": "A series converges conditionally if it converges but does not converge absolutely."
    },
    {
      "id": "s_power_series",
      "kind": "axiom",
      "name": "Power series",
      "type_signature": "",
      "description": "A series of the form sum c_n (x - a)^n, converging in a disk of radius R (the radius of convergence) centered at a."
    },
    {
      "id": "s_radius_of_convergence",
      "kind": "state",
      "name": "Radius of convergence",
      "type_signature": "",
      "description": "The nonneg extended real R such that a power series sum c_n z^n converges absolutely for |z| < R and diverges for |z| > R."
    },
    {
      "id": "s_rearrangement_of_series",
      "kind": "axiom",
      "name": "Rearrangement of a series",
      "type_signature": "",
      "description": "A series sum a_{sigma(n)} obtained from sum a_n by composing with a bijection sigma: N -> N."
    },
    {
      "id": "s_uniqueness_of_limits",
      "kind": "theorem",
      "name": "Uniqueness of limits in metric spaces",
      "type_signature": "",
      "description": "A convergent sequence in a metric space has exactly one limit."
    },
    {
      "id": "s_convergent_sequences_bounded",
      "kind": "theorem",
      "name": "Convergent sequences are bounded",
      "type_signature": "",
      "description": "If {p_n} converges in a metric space, then {p_n} is bounded."
    },
    {
      "id": "s_algebraic_limit_theorem",
      "kind": "theorem",
      "name": "Algebraic limit theorem for sequences",
      "type_signature": "",
      "description": "If {s_n} -> s and {t_n} -> t, then s_n + t_n -> s+t, s_n * t_n -> s*t, and s_n/t_n -> s/t (when t != 0)."
    },
    {
      "id": "s_subsequences_converge_to_same_limit",
      "kind": "theorem",
      "name": "Subsequences converge to the same limit",
      "type_signature": "",
      "description": "If {p_n} converges to p, then every subsequence of {p_n} also converges to p."
    },
    {
      "id": "s_completeness_of_Rk",
      "kind": "theorem",
      "name": "Completeness of R^k",
      "type_signature": "",
      "description": "The Euclidean space R^k is a complete metric space: every Cauchy sequence in R^k converges."
    },
    {
      "id": "s_limsup_liminf_always_exist",
      "kind": "theorem",
      "name": "Limsup and liminf always exist in the extended reals",
      "type_signature": "",
      "description": "For any sequence {s_n} of real numbers, lim sup s_n and lim inf s_n always exist in the extended real number system."
    },
    {
      "id": "s_cauchy_criterion_for_series",
      "kind": "theorem",
      "name": "Cauchy criterion for series convergence",
      "type_signature": "",
      "description": "The series sum a_n converges iff for every epsilon > 0 there exists N such that |sum_{n=m}^{p} a_n| < epsilon for all p >= m >= N."
    },
    {
      "id": "s_comparison_test",
      "kind": "theorem",
      "name": "Comparison test for series",
      "type_signature": "",
      "description": "If |a_n| <= c_n for all n >= N_0 and sum c_n converges, then sum a_n converges absolutely."
    },
    {
      "id": "s_cauchy_condensation_test",
      "kind": "theorem",
      "name": "Cauchy condensation test",
      "type_signature": "",
      "description": "If a_1 >= a_2 >= ... >= 0, then sum a_n converges if and only if sum 2^k a_{2^k} converges."
    },
    {
      "id": "s_p_series_convergence",
      "kind": "theorem",
      "name": "p-series convergence",
      "type_signature": "",
      "description": "The series sum 1/n^p converges if and only if p > 1."
    },
    {
      "id": "s_convergence_of_e_series",
      "kind": "theorem",
      "name": "Convergence of e = sum 1/n!",
      "type_signature": "",
      "description": "The series sum 1/n! converges, and its sum defines the number e; moreover, e is irrational."
    },
    {
      "id": "s_root_test",
      "kind": "theorem",
      "name": "Root test (Cauchy)",
      "type_signature": "",
      "description": "Let alpha = lim sup |a_n|^{1/n}. If alpha < 1, sum a_n converges absolutely; if alpha > 1, it diverges."
    },
    {
      "id": "s_ratio_test",
      "kind": "theorem",
      "name": "Ratio test (d'Alembert)",
      "type_signature": "",
      "description": "If lim sup |a_{n+1}/a_n| < 1, sum a_n converges; if |a_{n+1}/a_n| >= 1 for all n >= N, it diverges."
    },
    {
      "id": "s_root_test_stronger_than_ratio",
      "kind": "theorem",
      "name": "Root test is at least as strong as ratio test",
      "type_signature": "",
      "description": "lim inf |a_{n+1}/a_n| <= lim inf |a_n|^{1/n} <= lim sup |a_n|^{1/n} <= lim sup |a_{n+1}/a_n|."
    },
    {
      "id": "s_absolute_convergence_implies_convergence",
      "kind": "theorem",
      "name": "Absolute convergence implies convergence",
      "type_signature": "",
      "description": "If a series sum a_n converges absolutely, then it converges."
    },
    {
      "id": "s_abel_theorem_power_series",
      "kind": "theorem",
      "name": "Abel's theorem on power series",
      "type_signature": "",
      "description": "If sum c_n converges to s, then lim_{x->1^-} sum c_n x^n = s."
    },
    {
      "id": "s_cauchy_hadamard_formula",
      "kind": "theorem",
      "name": "Cauchy-Hadamard formula for radius of convergence",
      "type_signature": "",
      "description": "The radius of convergence of sum c_n z^n is R = 1 / lim sup |c_n|^{1/n}."
    },
    {
      "id": "s_riemann_rearrangement_theorem",
      "kind": "theorem",
      "name": "Riemann rearrangement theorem",
      "type_signature": "",
      "description": "If sum a_n is conditionally convergent, then for any alpha in [-inf, +inf] there exists a rearrangement converging to alpha."
    },
    {
      "id": "s_dirichlet_test_series",
      "kind": "theorem",
      "name": "Dirichlet's test for series convergence",
      "type_signature": "",
      "description": "If the partial sums of sum b_n are bounded and {a_n} is monotonically decreasing to 0, then sum a_n b_n converges."
    },
    {
      "id": "t_comparison_test_technique",
      "kind": "technique",
      "name": "Comparison test technique",
      "function_signature": "(Series sum a_n, dominating convergent series sum c_n) -> (Convergence of sum a_n)",
      "description": "Bounds the terms of a given series by those of a known convergent series to establish convergence."
    },
    {
      "id": "t_root_ratio_test_technique",
      "kind": "technique",
      "name": "Root and ratio test technique",
      "function_signature": "(Series sum a_n) -> (Convergence/divergence via lim sup of |a_n|^{1/n} or |a_{n+1}/a_n|)",
      "description": "Applies the root or ratio test to determine convergence by comparing the growth rate of terms to a geometric series."
    },
    {
      "id": "t_abel_summation_technique",
      "kind": "technique",
      "name": "Abel summation technique",
      "function_signature": "(Partial sums B_n of {b_n}, monotone sequence {a_n}) -> (Sum sum a_n b_n via summation by parts)",
      "description": "Rewrites sum a_n b_n using partial summation (discrete integration by parts) to transfer convergence."
    },
    {
      "id": "s_limit_of_function_at_point",
      "kind": "axiom",
      "name": "Limit of a function at a point",
      "type_signature": "",
      "description": "f(x) -> q as x -> p means: for every epsilon > 0 there exists delta > 0 such that 0 < d(x,p) < delta implies d(f(x),q) < epsilon."
    },
    {
      "id": "s_uniformly_continuous_function",
      "kind": "axiom",
      "name": "Uniformly continuous function",
      "type_signature": "",
      "description": "A function f: X -> Y between metric spaces is uniformly continuous if for every epsilon > 0 there exists delta > 0 such that d(x,y) < delta implies d(f(x),f(y)) < epsilon for all x,y."
    },
    {
      "id": "s_discontinuities_classification",
      "kind": "state",
      "name": "Classification of discontinuities",
      "type_signature": "",
      "description": "A function has a discontinuity of the first kind (jump) at x if one-sided limits exist but differ; of the second kind if at least one one-sided limit fails to exist."
    },
    {
      "id": "s_composition_continuous_is_continuous",
      "kind": "theorem",
      "name": "Composition of continuous functions is continuous",
      "type_signature": "",
      "description": "If f: X -> Y and g: Y -> Z are continuous, then g compose f: X -> Z is continuous."
    },
    {
      "id": "s_continuous_image_compact_is_compact",
      "kind": "theorem",
      "name": "Continuous image of compact set is compact",
      "type_signature": "",
      "description": "If f: X -> Y is continuous and K subset X is compact, then f(K) is compact in Y."
    },
    {
      "id": "s_continuous_preserves_connectedness",
      "kind": "theorem",
      "name": "Continuous image of connected set is connected",
      "type_signature": "",
      "description": "If f: X -> Y is continuous and E subset X is connected, then f(E) is connected."
    },
    {
      "id": "s_monotonic_jump_discontinuities",
      "kind": "theorem",
      "name": "Monotonic functions have countably many discontinuities",
      "type_signature": "",
      "description": "A monotonic function on an interval has at most countably many points of discontinuity, all of the first kind (jumps)."
    },
    {
      "id": "s_uniform_continuity_on_compact",
      "kind": "theorem",
      "name": "Uniform continuity theorem",
      "type_signature": "",
      "description": "A continuous function on a compact metric space is uniformly continuous."
    },
    {
      "id": "s_continuous_bijection_compact_hausdorff_homeomorphism",
      "kind": "theorem",
      "name": "Continuous bijection from compact to Hausdorff is homeomorphism",
      "type_signature": "",
      "description": "A continuous bijection from a compact space to a Hausdorff space is a homeomorphism."
    },
    {
      "id": "t_epsilon_delta_technique",
      "kind": "technique",
      "name": "Epsilon-delta technique",
      "function_signature": "(Target bound epsilon > 0) -> (Choice of delta > 0 ensuring the bound)",
      "description": "The standard technique for proving limits and continuity by choosing delta as a function of epsilon."
    },
    {
      "id": "s_continuously_differentiable",
      "kind": "axiom",
      "name": "Continuously differentiable function (C^1)",
      "type_signature": "",
      "description": "A function f is continuously differentiable on an interval if f' exists and is continuous on that interval."
    },
    {
      "id": "s_differentiability_implies_continuity",
      "kind": "theorem",
      "name": "Differentiability implies continuity",
      "type_signature": "",
      "description": "If f is differentiable at a point x, then f is continuous at x."
    },
    {
      "id": "s_local_extremum_theorem",
      "kind": "theorem",
      "name": "Local extremum theorem",
      "type_signature": "",
      "description": "If f has a local maximum or minimum at an interior point x and f'(x) exists, then f'(x) = 0."
    },
    {
      "id": "s_differentiation_vector_valued",
      "kind": "theorem",
      "name": "Differentiation of vector-valued functions",
      "type_signature": "",
      "description": "The derivative of f: [a,b] -> R^k exists iff each component has a derivative, and f' = (f_1', ..., f_k')."
    },
    {
      "id": "t_mvt_technique",
      "kind": "technique",
      "name": "Mean value theorem technique",
      "function_signature": "(Differentiable f on [a,b]) -> (Existence of c in (a,b) with f(b)-f(a) = f'(c)(b-a))",
      "description": "Applies the mean value theorem to connect the global change of a function to its derivative at an intermediate point."
    },
    {
      "id": "t_lhopital_technique",
      "kind": "technique",
      "name": "L'Hopital technique",
      "function_signature": "(Indeterminate form 0/0 or inf/inf) -> (Limit via ratio of derivatives)",
      "description": "Evaluates limits of indeterminate forms by replacing f(x)/g(x) with f'(x)/g'(x)."
    },
    {
      "id": "t_taylor_expansion_technique",
      "kind": "technique",
      "name": "Taylor expansion technique",
      "function_signature": "(n-times differentiable f at a) -> (Polynomial approximation with remainder estimate)",
      "description": "Approximates a function near a point by its Taylor polynomial and estimates the remainder."
    },
    {
      "id": "s_partition_of_interval",
      "kind": "axiom",
      "name": "Partition of an interval",
      "type_signature": "",
      "description": "A finite set of points P = {x_0, x_1, ..., x_n} with a = x_0 < x_1 < ... < x_n = b, dividing [a,b] into subintervals."
    },
    {
      "id": "s_upper_lower_rs_sums",
      "kind": "state",
      "name": "Upper and lower Riemann-Stieltjes sums",
      "type_signature": "",
      "description": "For bounded f on [a,b] with increasing integrator alpha and partition P: U(P,f,alpha) = sum sup f * Delta alpha and L(P,f,alpha) = sum inf f * Delta alpha."
    },
    {
      "id": "s_riemann_stieltjes_integral_definition",
      "kind": "axiom",
      "name": "Riemann-Stieltjes integral",
      "type_signature": "",
      "description": "The integral of f with respect to alpha on [a,b], defined as the common value of inf U(P,f,alpha) and sup L(P,f,alpha) when they agree."
    },
    {
      "id": "s_riemann_integral",
      "kind": "axiom",
      "name": "Riemann integral",
      "type_signature": "",
      "description": "The special case of the Riemann-Stieltjes integral when alpha(x) = x, giving the classical integral of f over [a,b]."
    },
    {
      "id": "s_bounded_variation",
      "kind": "axiom",
      "name": "Function of bounded variation",
      "type_signature": "",
      "description": "A function f on [a,b] has bounded variation if sup sum |f(x_i) - f(x_{i-1})| over all partitions is finite; this supremum is the total variation."
    },
    {
      "id": "s_rectifiable_curve",
      "kind": "state",
      "name": "Rectifiable curve and arc length",
      "type_signature": "",
      "description": "A continuous curve gamma: [a,b] -> R^k is rectifiable if its arc length Lambda(gamma) = sup sum |gamma(t_i) - gamma(t_{i-1})| is finite."
    },
    {
      "id": "s_rs_integrability_criterion",
      "kind": "theorem",
      "name": "Riemann-Stieltjes integrability criterion",
      "type_signature": "",
      "description": "f is R-S integrable with respect to alpha iff for every epsilon > 0 there exists a partition P with U(P,f,alpha) - L(P,f,alpha) < epsilon."
    },
    {
      "id": "s_continuous_functions_rs_integrable",
      "kind": "theorem",
      "name": "Continuous functions are R-S integrable",
      "type_signature": "",
      "description": "If f is continuous on [a,b] and alpha is monotonically increasing, then f is R-S integrable with respect to alpha."
    },
    {
      "id": "s_monotonic_functions_rs_integrable",
      "kind": "theorem",
      "name": "Monotonic functions are R-S integrable",
      "type_signature": "",
      "description": "If f is monotonic on [a,b] and alpha is continuous and monotonically increasing, then f is R-S integrable with respect to alpha."
    },
    {
      "id": "s_rs_step_integrator",
      "kind": "theorem",
      "name": "R-S integral with step function integrator",
      "type_signature": "",
      "description": "If alpha has a jump at s and f is continuous at s, then integral f dalpha = a * f(s)."
    },
    {
      "id": "s_rs_reduces_to_riemann",
      "kind": "theorem",
      "name": "R-S integral reduces to Riemann integral",
      "type_signature": "",
      "description": "If alpha is differentiable with alpha' Riemann integrable, then integral f dalpha = integral f(x) alpha'(x) dx."
    },
    {
      "id": "s_linearity_of_rs_integral",
      "kind": "theorem",
      "name": "Linearity of the Riemann-Stieltjes integral",
      "type_signature": "",
      "description": "The R-S integral is linear in both the integrand and the integrator."
    },
    {
      "id": "s_additivity_over_intervals",
      "kind": "theorem",
      "name": "Additivity of the integral over intervals",
      "type_signature": "",
      "description": "If f is integrable on [a,b] and c in (a,b), then integral_a^b f dalpha = integral_a^c f dalpha + integral_c^b f dalpha."
    },
    {
      "id": "s_ftc_first_form",
      "kind": "theorem",
      "name": "Fundamental theorem of calculus (first form)",
      "type_signature": "",
      "description": "If f is Riemann integrable and F(x) = integral_a^x f(t) dt, then F is continuous; if f is continuous at x_0, then F'(x_0) = f(x_0)."
    },
    {
      "id": "s_ftc_second_form",
      "kind": "theorem",
      "name": "Fundamental theorem of calculus (second form)",
      "type_signature": "",
      "description": "If F' = f is Riemann integrable on [a,b], then integral_a^b f(x) dx = F(b) - F(a)."
    },
    {
      "id": "s_rectifiable_curves_finite_arc_length",
      "kind": "theorem",
      "name": "Rectifiable curves characterized via bounded variation",
      "type_signature": "",
      "description": "A curve gamma is rectifiable iff each component is of bounded variation; if gamma' is continuous, Lambda(gamma) = integral |gamma'(t)| dt."
    },
    {
      "id": "t_rs_integration_technique",
      "kind": "technique",
      "name": "Riemann-Stieltjes integration technique",
      "function_signature": "(Bounded f, monotone integrator alpha, partition P) -> (Approximation of integral via upper/lower sums)",
      "description": "Computes or estimates integrals by refining partitions and bounding the difference of upper and lower R-S sums."
    },
    {
      "id": "s_pointwise_convergence_definition",
      "kind": "axiom",
      "name": "Pointwise convergence of function sequence",
      "type_signature": "",
      "description": "A sequence {f_n} converges pointwise to f on E if for each x in E, lim f_n(x) = f(x)."
    },
    {
      "id": "s_uniform_convergence_definition",
      "kind": "axiom",
      "name": "Uniform convergence of function sequence",
      "type_signature": "",
      "description": "{f_n} converges uniformly to f on E if for every epsilon > 0 there exists N such that |f_n(x) - f(x)| < epsilon for all n >= N and all x in E."
    },
    {
      "id": "s_pointwise_bounded_family",
      "kind": "axiom",
      "name": "Pointwise bounded family of functions",
      "type_signature": "",
      "description": "A family {f_n} on E is pointwise bounded if for each x in E there exists M(x) such that |f_n(x)| <= M(x) for all n."
    },
    {
      "id": "s_uniformly_bounded_family",
      "kind": "axiom",
      "name": "Uniformly bounded family of functions",
      "type_signature": "",
      "description": "A family {f_n} on E is uniformly bounded if there exists M such that |f_n(x)| <= M for all n and all x in E."
    },
    {
      "id": "s_algebra_of_functions",
      "kind": "axiom",
      "name": "Algebra of functions and subalgebra of C(X)",
      "type_signature": "",
      "description": "An algebra A of continuous functions on a compact set X, closed under pointwise addition, multiplication, and scalar multiplication."
    },
    {
      "id": "s_separating_points",
      "kind": "axiom",
      "name": "Algebra separating points",
      "type_signature": "",
      "description": "An algebra A of functions on X separates points if for any distinct x,y in X there exists f in A with f(x) != f(y)."
    },
    {
      "id": "s_self_adjoint_algebra",
      "kind": "axiom",
      "name": "Self-adjoint algebra of functions",
      "type_signature": "",
      "description": "A complex algebra A of functions is self-adjoint if for every f in A, its complex conjugate f-bar is also in A."
    },
    {
      "id": "s_cauchy_criterion_uniform_convergence",
      "kind": "theorem",
      "name": "Cauchy criterion for uniform convergence",
      "type_signature": "",
      "description": "{f_n} converges uniformly on E iff for every epsilon > 0 there exists N such that |f_n(x) - f_m(x)| < epsilon for all m,n >= N and all x in E."
    },
    {
      "id": "s_weierstrass_m_test",
      "kind": "theorem",
      "name": "Weierstrass M-test",
      "type_signature": "",
      "description": "If |f_n(x)| <= M_n for all x in E and sum M_n converges, then sum f_n converges uniformly and absolutely on E."
    },
    {
      "id": "s_uniform_limit_continuous",
      "kind": "theorem",
      "name": "Uniform limit of continuous functions is continuous",
      "type_signature": "",
      "description": "If {f_n} are continuous and f_n -> f uniformly on E, then f is continuous on E."
    },
    {
      "id": "s_term_by_term_integration",
      "kind": "theorem",
      "name": "Term-by-term integration of uniformly convergent series",
      "type_signature": "",
      "description": "If f_n -> f uniformly on [a,b] and each f_n is Riemann integrable, then f is integrable and integral f = lim integral f_n."
    },
    {
      "id": "s_uniform_limit_rs_integrable",
      "kind": "theorem",
      "name": "Uniform limit of R-S integrable functions is R-S integrable",
      "type_signature": "",
