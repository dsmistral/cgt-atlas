      "name": "Primary decomposition for modules over PIDs",
      "type_signature": "",
      "description": "A finitely generated torsion module over a PID decomposes uniquely as a direct sum of primary cyclic modules R/(p^k), giving the elementary divisor form of the structure theorem."
    },
    {
      "id": "s_localization_is_exact",
      "kind": "theorem",
      "name": "Localization is exact",
      "type_signature": "",
      "description": "The localization functor S^{-1}(-) is exact, preserving short exact sequences of modules; equivalently, S^{-1}R is a flat R-module."
    },
    {
      "id": "s_archimedean_and_nonarchimedean_places",
      "kind": "axiom",
      "name": "Archimedean and non-archimedean places",
      "type_signature": "",
      "description": "A place of a number field K is an equivalence class of absolute values; archimedean places correspond to embeddings K → ℝ or ℂ, non-archimedean places to prime ideals of O_K; there are r_1+r_2 archimedean and infinitely many non-archimedean places."
    },
    {
      "id": "s_artins_theorem_on_simple_rings",
      "kind": "theorem",
      "name": "Artin's theorem on simple rings",
      "type_signature": "",
      "description": "A left Artinian simple ring is isomorphic to M_n(D) for some division ring D and positive integer n; equivalently, a simple ring is left semisimple if and only if it is left Artinian."
    },
    {
      "id": "t_buchbergers_algorithm",
      "kind": "technique",
      "name": "Buchberger's algorithm",
      "function_signature": "(Finite generating set of polynomial ideal, Monomial order) → (Gröbner basis)",
      "description": "An algorithm that computes a Gröbner basis from any finite generating set of a polynomial ideal by iteratively computing S-polynomials, reducing, and adjoining nonzero remainders."
    },
    {
      "id": "s_buchbergers_criterion",
      "kind": "theorem",
      "name": "Buchberger's criterion",
      "type_signature": "",
      "description": "A finite set G is a Gröbner basis for the ideal it generates iff for every pair g_i, g_j in G, the remainder of S(g_i,g_j) on division by G is zero."
    },
    {
      "id": "s_burnsides_theorem_on_matrix_algebras",
      "kind": "theorem",
      "name": "Burnside's theorem on matrix algebras",
      "type_signature": "",
      "description": "If V is a finite-dimensional vector space over an algebraically closed field F, then any subalgebra of End_F(V) acting irreducibly on V equals all of End_F(V) ≅ M_n(F)."
    },
    {
      "id": "s_change_of_rings_for_ext",
      "kind": "theorem",
      "name": "Change of rings for Ext",
      "type_signature": "",
      "description": "For a ring homomorphism φ: R → S, there are natural maps and spectral sequences relating Ext over R and Ext over S; in particular, if S is flat over R, then Ext^n_S(M⊗_R S, N) relates to Ext^n_R(M, N)."
    },
    {
      "id": "s_change_of_rings_for_tor",
      "kind": "theorem",
      "name": "Change of rings for Tor",
      "type_signature": "",
      "description": "For a ring homomorphism R → S and modules M_R, _SN, there is a natural isomorphism Tor_n^R(M, N) ≅ Tor_n^S(M⊗_R S, N) when S is flat as a right R-module."
    },
    {
      "id": "s_cocycle_and_coboundary_group_cohomology",
      "kind": "axiom",
      "name": "Cocycle and coboundary (group cohomology)",
      "type_signature": "",
      "description": "An n-cocycle is an n-cochain f: G^n → M satisfying δf = 0; an n-coboundary is f = δg for an (n-1)-cochain g; H^n(G,M) = Z^n/B^n where Z^n = ker δ, B^n = im δ."
    },
    {
      "id": "s_comparison_theorem_projective_resolutions",
      "kind": "theorem",
      "name": "Comparison theorem (projective resolutions)",
      "type_signature": "",
      "description": "Any module homomorphism M → N lifts to a chain map between projective resolutions of M and N, and this lift is unique up to chain homotopy."
    },
    {
      "id": "t_composition_of_binary_quadratic_forms_gauss_composition",
      "kind": "technique",
      "name": "Composition of binary quadratic forms (Gauss composition)",
      "function_signature": "(Two primitive binary quadratic forms of discriminant D) → (Composed form class)",
      "description": "Gauss's law of composition defines a group operation on proper equivalence classes of primitive binary quadratic forms of fixed discriminant D, making them into a finite abelian group called the form class group."
    },
    {
      "id": "s_correspondence_between_forms_and_ideals",
      "kind": "theorem",
      "name": "Correspondence between forms and ideals",
      "type_signature": "",
      "description": "There is a canonical bijection between proper equivalence classes of primitive binary quadratic forms of discriminant D and strict equivalence classes of ideals in the ring of integers of ℚ(√D), compatible with composition and multiplication."
    },
    {
      "id": "s_crossed_product_algebra",
      "kind": "state",
      "name": "Crossed product algebra",
      "type_signature": "",
      "description": "For a Galois extension K/F with group G and factor set f, the crossed product (K/F, G, f) = ⊕_{σ∈G} Ku_σ with multiplication u_σ u_τ = f(σ,τ)u_{στ} and u_σ a = σ(a)u_σ for a ∈ K; it is a central simple algebra over F."
    },
    {
      "id": "s_cyclic_algebra",
      "kind": "state",
      "name": "Cyclic algebra",
      "type_signature": "",
      "description": "For a cyclic extension K/F of degree n with generator σ and a ∈ F×, the cyclic algebra (K/F, σ, a) = ⊕_{i=0}^{n-1} Ku^i with u^n = a and ua = σ(a)u; a central simple algebra over F."
    },
    {
      "id": "s_universal_delta_functor",
      "kind": "axiom",
      "name": "Delta-functor (universal)",
      "type_signature": "",
      "description": "A sequence of functors {T^n}_{n≥0} with connecting homomorphisms δ^n: T^n(C) → T^{n+1}(A) for each short exact sequence, forming long exact sequences; a universal δ-functor is characterized by T^n being coeffaceable for n ≥ 1."
    },
    {
      "id": "s_discriminant_of_a_number_field",
      "kind": "state",
      "name": "Discriminant of a number field",
      "type_signature": "",
      "description": "For a number field K with [K:ℚ] = n and integral basis {ω_1,...,ω_n}, the discriminant d_K = det(σ_i(ω_j))^2 where σ_i are the n embeddings K → ℂ; an invariant of K detecting ramification."
    },
    {
      "id": "s_real_complex_embeddings_of_number_field",
      "kind": "axiom",
      "name": "Embedding of K into ℝ^n (real and complex places)",
      "type_signature": "",
      "description": "A number field K of degree n has r_1 real embeddings σ_i: K → ℝ and r_2 pairs of complex conjugate embeddings τ_j, τ̄_j: K → ℂ, with r_1 + 2r_2 = n; these define the archimedean places of K."
    },
    {
      "id": "s_euler_product",
      "kind": "state",
      "name": "Euler product",
      "type_signature": "",
      "description": "A product representation ∏_p f(p,s) over primes p for a Dirichlet series, expressing multiplicativity of the coefficients; the Riemann zeta function has ζ(s) = ∏_p (1-p^{-s})^{-1}."
    },
    {
      "id": "s_exponent_of_a_central_simple_algebra",
      "kind": "state",
      "name": "Exponent of a central simple algebra",
      "type_signature": "",
      "description": "The order of [A] in the Brauer group Br(F); always divides the index and shares the same prime factors: if ind(A) = p_1^{a_1}...p_k^{a_k}, then exp(A) = p_1^{b_1}...p_k^{b_k} with 1 ≤ b_i ≤ a_i."
    },
    {
      "id": "s_ext1_classifies_extensions",
      "kind": "theorem",
      "name": "Ext^1 and extensions",
      "type_signature": "",
      "description": "There is a natural bijection between Ext^1_R(C,A) and equivalence classes of short exact sequences 0 → A → B → C → 0, with the Baer sum making this correspondence a group isomorphism."
    },
    {
      "id": "s_finiteness_of_form_classes",
      "kind": "theorem",
      "name": "Finiteness of form classes",
      "type_signature": "",
      "description": "For any discriminant D < 0, the number of proper equivalence classes of primitive positive definite binary quadratic forms of discriminant D is finite."
    },
    {
      "id": "s_form_class_group",
      "kind": "state",
      "name": "Form class group",
      "type_signature": "",
      "description": "The finite abelian group of proper equivalence classes of primitive binary quadratic forms of discriminant D under Gauss composition; its order h(D) is the class number."
    },
    {
      "id": "s_frobenius_theorem_real_division_algebras",
      "kind": "theorem",
      "name": "Frobenius theorem (real division algebras)",
      "type_signature": "",
      "description": "The only finite-dimensional associative division algebras over ℝ are ℝ, ℂ, and the quaternions ℍ."
    },
    {
      "id": "s_fundamental_identity_efg_equals_n",
      "kind": "theorem",
      "name": "Fundamental identity e·f·g = n",
      "type_signature": "",
      "description": "For a prime p in ℤ and K/ℚ of degree n, if pO_K = P_1^{e_1}...P_g^{e_g} with f_i = f(P_i|p), then ∑_{i=1}^g e_i f_i = n; in the Galois case all e_i and f_i are equal so efg = n."
    },
    {
      "id": "s_gausss_lemma_quadratic_residues",
      "kind": "theorem",
      "name": "Gauss's lemma (quadratic residues)",
      "type_signature": "",
      "description": "If p is an odd prime and gcd(a,p)=1, then (a/p) = (-1)^n where n is the number of least positive residues of a, 2a, ..., ((p-1)/2)a modulo p that exceed p/2."
    },
    {
      "id": "s_genus_of_a_binary_quadratic_form",
      "kind": "axiom",
      "name": "Genus of a binary quadratic form",
      "type_signature": "",
      "description": "A genus is a set of proper equivalence classes of binary quadratic forms of discriminant D that represent the same values modulo D (or 4D); genera partition the form class group and form a quotient group."
    },
    {
      "id": "s_hilberts_theorem_on_hilbert_polynomial",
      "kind": "theorem",
      "name": "Hilbert's theorem on Hilbert polynomial",
      "type_signature": "",
      "description": "For a finitely generated graded module over k[X_0,...,X_n], the Hilbert function agrees with a polynomial (the Hilbert polynomial) for all sufficiently large arguments."
    },
    {
      "id": "s_hom_functor",
      "kind": "axiom",
      "name": "Hom functor",
      "type_signature": "",
      "description": "The bifunctor Hom_R(-,-): R-Mod^op × R-Mod → Ab; contravariant and left exact in the first variable, covariant and left exact in the second; its right derived functors are Ext^n."
    },
    {
      "id": "s_hurwitz_formula",
      "kind": "theorem",
      "name": "Hurwitz formula",
      "type_signature": "",
      "description": "For a nonconstant morphism f: C -> C' of smooth projective curves of genera g and g', 2g-2 = deg(f)*(2g'-2) + sum_{P in C} (e_P - 1), where e_P is the ramification index at P."
    },
    {
      "id": "s_induced_module",
      "kind": "state",
      "name": "Induced module",
      "type_signature": "",
      "description": "For a subgroup H ≤ G and an H-module M, the induced module Ind_H^G(M) = ℤ[G] ⊗_{ℤ[H]} M; satisfies Shapiro's lemma: H^n(G, Ind_H^G M) ≅ H^n(H, M)."
    },
    {
      "id": "s_inner_automorphism",
      "kind": "axiom",
      "name": "Inner automorphism",
      "type_signature": "",
      "description": "An automorphism of a ring or algebra A of the form x ↦ uxu^{-1} for some invertible element u ∈ A; the Skolem-Noether theorem shows all automorphisms of a central simple algebra are inner."
    },
    {
      "id": "s_brauer_group_h2_isomorphism",
      "kind": "theorem",
      "name": "Isomorphism Br(K/F) ≅ H²(Gal(K/F), K×)",
      "type_signature": "",
      "description": "For a finite Galois extension K/F, the map sending a factor set to its crossed product algebra induces a group isomorphism from H²(Gal(K/F), K×) to the relative Brauer group Br(K/F)."
    },
    {
      "id": "s_jacobian_criterion_for_nonsingularity",
      "kind": "theorem",
      "name": "Jacobian criterion for nonsingularity",
      "type_signature": "",
      "description": "A point P on the zero set V(I) in k^n is nonsingular iff the Jacobian matrix (partial f_i/partial x_j) evaluated at P has rank n - dim(V), where the f_i generate I."
    },
    {
      "id": "s_left_noetherian_ring",
      "kind": "axiom",
      "name": "Left Noetherian ring",
      "type_signature": "",
      "description": "A ring R with identity whose left ideals satisfy the ascending chain condition (ACC): every ascending chain of left ideals stabilizes."
    },
    {
      "id": "s_macaulays_theorem",
      "kind": "theorem",
      "name": "Macaulay's theorem",
      "type_signature": "",
      "description": "The Hilbert function of an ideal I equals the Hilbert function of its leading term ideal LT(I), so computing with Gröbner bases reduces Hilbert function computation to the monomial case."
    },
    {
      "id": "s_minkowskis_discriminant_bound",
      "kind": "theorem",
      "name": "Minkowski's discriminant bound",
      "type_signature": "",
      "description": "For any number field K ≠ ℚ, |d_K| > 1; combined with the Dedekind discriminant theorem, this proves every number field other than ℚ has a ramified prime."
    },
    {
      "id": "s_minkowskis_lattice_point_theorem",
      "kind": "theorem",
      "name": "Minkowski's lattice point theorem",
      "type_signature": "",
      "description": "If Λ is a lattice in ℝ^n and S is a convex symmetric body with vol(S) > 2^n vol(ℝ^n/Λ), then S contains a nonzero lattice point; used to prove finiteness of class number and Dirichlet's unit theorem."
    },
    {
      "id": "s_norm_map_nkf",
      "kind": "state",
      "name": "Norm map N_{K/F}",
      "type_signature": "",
      "description": "For a finite extension K/F, N_{K/F}(α) = ∏_{σ} σ(α) over all F-embeddings σ of K; for Galois K/F, N_{K/F}: K× → F× is surjective onto its image and its kernel appears in Hilbert's theorem 90."
    },
    {
      "id": "s_nullstellensatz_fieldtheoretic_form",
      "kind": "theorem",
      "name": "Nullstellensatz (field-theoretic form)",
      "type_signature": "",
      "description": "If K is a field and L is a finitely generated K-algebra that is a field, then L is a finite algebraic extension of K."
    },
    {
      "id": "s_periodicity_of_cohomology_for_cyclic_groups",
      "kind": "theorem",
      "name": "Periodicity of cohomology for cyclic groups",
      "type_signature": "",
      "description": "If G is a finite cyclic group and M is a G-module, then Ĥ^n(G,M) ≅ Ĥ^{n+2}(G,M) for all n ∈ ℤ in Tate cohomology; in particular H²(G,M) ≅ Ĥ^0(G,M) = M^G/N(M)."
    },
    {
      "id": "s_principal_genus",
      "kind": "axiom",
      "name": "Principal genus",
      "type_signature": "",
      "description": "The genus containing the principal form x^2 - (D/4)y^2 (D even) or x^2 + xy + (1-D)/4 y^2 (D odd); it equals the subgroup of squares in the form class group."
    },
    {
      "id": "s_proj_construction",
      "kind": "state",
      "name": "Proj construction",
      "type_signature": "",
      "description": "For a graded ring S = direct sum S_d, Proj(S) is the scheme whose points are homogeneous prime ideals not containing the irrelevant ideal S_+, with structure sheaf built from degree-zero localizations; globalizes projective varieties."
    },
    {
      "id": "s_proper_equivalence_of_binary_quadratic_forms",
      "kind": "axiom",
      "name": "Proper equivalence of binary quadratic forms",
      "type_signature": "",
      "description": "Two binary quadratic forms f and g are properly equivalent if g is obtained from f by a linear substitution with matrix in SL_2(ℤ); this preserves the discriminant."
    },
    {
      "id": "s_quadratic_number_field",
      "kind": "axiom",
      "name": "Quadratic number field",
      "type_signature": "",
      "description": "A number field of the form ℚ(√d) where d is a squarefree integer; its ring of integers is ℤ[(1+√d)/2] if d ≡ 1 mod 4, and ℤ[√d] otherwise."
    },
    {
      "id": "s_quaternion_algebra",
      "kind": "axiom",
      "name": "Quaternion algebra",
      "type_signature": "",
      "description": "A 4-dimensional central simple algebra over a field F generated by i,j with i^2=a, j^2=b, ij=-ji for a,b ∈ F×; denoted (a,b)_F; splits (≅ M_2(F)) iff the norm form ax^2+by^2-abz^2 represents 1."
    },
    {
      "id": "s_ramification_of_primes",
      "kind": "axiom",
      "name": "Ramification of primes",
      "type_signature": "",
      "description": "A prime p ∈ ℤ ramifies in O_K if pO_K = ∏ P_i^{e_i} with some e_i > 1; p is unramified if all e_i = 1; p is totally ramified if there is a single prime P with e = [K:ℚ]."
    },
    {
      "id": "s_reduced_binary_quadratic_form",
      "kind": "axiom",
      "name": "Reduced binary quadratic form",
      "type_signature": "",
      "description": "A positive definite form ax^2+bxy+cy^2 with D<0 is reduced if |b| ≤ a ≤ c, and b ≥ 0 when |b|=a or a=c; each proper equivalence class contains a unique reduced form."
    },
    {
      "id": "s_relative_brauer_group",
      "kind": "state",
      "name": "Relative Brauer group",
      "type_signature": "",
      "description": "For a field extension K/F, the relative Brauer group Br(K/F) = ker(Br(F) → Br(K)) consists of classes of CSAs over F split by K; Br(F) = ∪_K Br(K/F) over all finite extensions K/F."
    },
    {
      "id": "s_relative_brauer_group_for_cyclic_extensions",
      "kind": "theorem",
      "name": "Relative Brauer group for cyclic extensions",
      "type_signature": "",
      "description": "If K/F is a cyclic Galois extension of degree n with generator σ, then Br(K/F) ≅ F×/N_{K/F}(K×); every element is represented by a cyclic algebra (K/F, σ, a) for some a ∈ F×."
    },
    {
      "id": "s_restriction_and_corestriction_maps",
      "kind": "state",
      "name": "Restriction and corestriction maps",
      "type_signature": "",
      "description": "For a subgroup H ≤ G: restriction res: H^n(G,M) → H^n(H,M) and corestriction cor: H^n(H,M) → H^n(G,M) satisfy cor ∘ res = [G:H]; these are fundamental maps in group cohomology."
    },
    {
      "id": "s_riemann_inequality_for_curves",
      "kind": "theorem",
      "name": "Riemann's inequality",
      "type_signature": "",
      "description": "For any divisor D on a smooth projective curve C of genus g, l(D) >= deg(D) + 1 - g, with equality for divisors of sufficiently large degree."
    },
    {
      "id": "s_riemann_roch_space",
      "kind": "state",
      "name": "Riemann-Roch space",
      "type_signature": "",
      "description": "For a divisor D on C, L(D) = {f in k(C)* : div(f) + D >= 0} union {0}, a finite-dimensional k-vector space whose dimension l(D) measures sections of the associated line bundle."
    },
    {
      "id": "s_riemann_roch_theorem_for_curves",
      "kind": "theorem",
      "name": "Riemann-Roch theorem for algebraic curves",
      "type_signature": "",
      "description": "For a smooth projective curve C of genus g and divisor D, l(D) - l(K_C - D) = deg(D) - g + 1, where K_C is a canonical divisor."
    },
    {
      "id": "s_second_cohomology_group_h2",
      "kind": "state",
      "name": "Second cohomology group H²(G,M)",
      "type_signature": "",
      "description": "H²(G,M) classifies equivalence classes of factor sets (2-cocycles) f: G×G → M modulo 2-coboundaries; equivalently classifies group extensions 1 → M → E → G → 1 with given G-action on M."
    },
    {
      "id": "s_segre_embedding",
      "kind": "state",
      "name": "Segre embedding",
      "type_signature": "",
      "description": "The map P^m x P^n -> P^{mn+m+n} sending ([x_i],[y_j]) to [x_i*y_j]; realizes the product of projective spaces as a projective variety."
    },
    {
      "id": "t_semisimple_decomposition_via_idempotents",
      "kind": "technique",
      "name": "Semisimple decomposition via idempotents",
      "function_signature": "(Semisimple ring R) → (Central primitive idempotent decomposition 1 = e_1 + ... + e_k)",
      "description": "In a semisimple ring R ≅ ∏ M_{n_i}(D_i), the identity 1 = e_1 + ... + e_k decomposes into central primitive idempotents corresponding to the simple factors; each Re_i is a minimal two-sided ideal."
    },
    {
      "id": "s_semisimplicity_and_tensor_products",
      "kind": "theorem",
      "name": "Semisimplicity and tensor products",
      "type_signature": "",
      "description": "If A is a central simple algebra over F and B is a semisimple F-algebra, then A ⊗_F B is semisimple; the tensor product of two central simple algebras over F is again central simple."
    },
    {
      "id": "s_splitting_field_of_a_central_simple_algebra",
      "kind": "axiom",
      "name": "Splitting field of a central simple algebra",
      "type_signature": "",
      "description": "A field extension K/F such that A ⊗_F K ≅ M_n(K); every CSA is split by some finite separable extension, and K splits A iff A ⊗_F K is trivial in Br(K)."
    },
    {
      "id": "t_splitting_field_of_a_polynomial_over_a_finite_field",
      "kind": "technique",
      "name": "Splitting field of a polynomial over a finite field",
      "function_signature": "(Polynomial f(x) ∈ ℤ[x], Prime p) → (Factorization of (p) in O_K)",
      "description": "The technique of factoring a polynomial f(x) ∈ ℤ[x] modulo a prime p to determine the splitting of (p) in O_K = ℤ[α]/f(α) via Kummer's criterion; the degrees of irreducible factors give the inertia degrees."
    },
    {
      "id": "s_splitting_of_primes",
      "kind": "axiom",
      "name": "Splitting of primes",
      "type_signature": "",
      "description": "A prime p in ℤ splits in O_K as pO_K = P_1^{e_1}...P_g^{e_g} with ∑ e_i f_i = [K:ℚ] where f_i = [O_K/P_i : ℤ/p]; p splits completely if g = [K:ℚ] (all e_i = f_i = 1)."
    },
    {
      "id": "s_tensor_product_of_algebras",
      "kind": "axiom",
      "name": "Tensor product of algebras",
      "type_signature": "",
      "description": "For F-algebras A and B, the tensor product A ⊗_F B is an F-algebra with multiplication (a₁⊗b₁)(a₂⊗b₂) = a₁a₂ ⊗ b₁b₂; preserves simplicity and centrality when both factors are central simple."
    },
    {
      "id": "s_tor_and_flatness_criterion",
      "kind": "theorem",
      "name": "Tor and flatness criterion",
      "type_signature": "",
      "description": "An R-module M is flat if and only if Tor_1^R(M,R/I) = 0 for every finitely generated ideal I; equivalently Tor_1^R(M,N) = 0 for all R-modules N."
    },
    {
      "id": "s_trace_map_trkf",
      "kind": "state",
      "name": "Trace map Tr_{K/F}",
      "type_signature": "",
      "description": "For a finite extension K/F, Tr_{K/F}(α) = ∑_σ σ(α) summed over all F-embeddings σ: K → F̄; an F-linear map K → F used to define the discriminant and different."
    },
    {
      "id": "s_units_of_quadratic_number_fields",
      "kind": "state",
      "name": "Units of quadratic number fields",
      "type_signature": "",
      "description": "The group of units of the ring of integers of ℚ(√d): for d < 0, it is finite ({±1} or {±1, ±i} or the 6th roots of unity); for d > 0, it is {±ε^n : n ∈ ℤ} for a fundamental unit ε."
    },
    {
      "id": "s_universal_coefficients_theorem_algebraic",
      "kind": "theorem",
      "name": "Universal coefficients theorem (algebraic)",
      "type_signature": "",
      "description": "For a chain complex C• of free abelian groups, there are natural short exact sequences 0 → H_n(C)⊗G → H_n(C;G) → Tor_1(H_{n-1}(C),G) → 0 and 0 → Ext^1(H_{n-1}(C),G) → H^n(C;G) → Hom(H_n(C),G) → 0, both split."
    },
    {
      "id": "s_veronese_embedding",
      "kind": "state",
      "name": "Veronese embedding",
      "type_signature": "",
      "description": "The map v_d: P^n -> P^N sending [x_0:...:x_n] to all monomials of degree d, where N = binom(n+d,d)-1; an embedding whose image is a projective variety."
    },
    {
      "id": "s_wedderburns_main_theorem",
      "kind": "theorem",
      "name": "Wedderburn's main theorem",
      "type_signature": "",
      "description": "If R is a finite-dimensional associative algebra over a field of characteristic 0, then R contains a semisimple subalgebra S such that R = S ⊕ rad(R) as vector spaces, with S ≅ R/rad(R)."
    },
    {
      "id": "s_wedderburns_theorem_semisimple_rings",
      "kind": "theorem",
      "name": "Wedderburn's theorem (semisimple rings)",
      "type_signature": "",
      "description": "A left semisimple ring R with identity is isomorphic to a finite product M_{n_1}(D_1) × ... × M_{n_k}(D_k) of full matrix rings over division rings D_i; the factors are unique up to order and isomorphism."
    },
    {
      "id": "s_wedderburnartin_radical",
      "kind": "state",
      "name": "Wedderburn-Artin radical",
      "type_signature": "",
      "description": "For a left Artinian ring R, rad(R) is the sum of all nilpotent left ideals; it is the unique maximal nilpotent two-sided ideal, and R/rad(R) is semisimple."
    },
    {
      "id": "s_weierstrass_equation",
      "kind": "state",
      "name": "Weierstrass equation",
      "type_signature": "",
      "description": "A model y^2 = x^3 + ax + b (char != 2,3) or y^2 + a_1 xy + a_3 y = x^3 + a_2 x^2 + a_4 x + a_6 for an elliptic curve, obtained via Riemann-Roch; nonsingular iff discriminant != 0."
    },
    {
      "id": "s_weil_differential_repartition",
      "kind": "axiom",
      "name": "Weil differential (repartition)",
      "type_signature": "",
      "description": "A k-linear functional on the adele space of k(C) that vanishes on the adeles of bounded denominators at each place, used to define the canonical class and prove Riemann-Roch."
    },
    {
      "id": "s_zariski_topology_on_specr",
      "kind": "axiom",
      "name": "Zariski topology on Spec(R)",
      "type_signature": "",
      "description": "The topology on Spec(R) with closed sets V(I) = {p : p supset I} and basis of open sets D(f) = {p : f not in p}; Spec(R) is always quasi-compact."
    },
    {
      "id": "s_zariski_topology_on_affine_space",
      "kind": "axiom",
      "name": "Zariski topology on affine space",
      "type_signature": "",
      "description": "The topology on k^n (or an affine variety V) where closed sets are affine algebraic sets V(I); has very few open sets (not Hausdorff except for finite sets) but is Noetherian."
    },
    {
      "id": "s_zariski_topology_on_projective_space",
      "kind": "axiom",
      "name": "Zariski topology on projective space",
      "type_signature": "",
      "description": "The topology on P^n where closed sets are V(I) for homogeneous ideals I of k[X_0,...,X_n]; the projective analog of the affine Zariski topology."
    },
    {
      "id": "s_zariskis_theorem_on_nonsingular_points",
      "kind": "theorem",
      "name": "Zariski's theorem on nonsingular points",
      "type_signature": "",
      "description": "A point P on an irreducible variety V is nonsingular iff the local ring O_{V,P} is a regular local ring; equivalently, dim(m_P/m_P^2) = dim(V), and nonsingular points form a dense open set."
    },
    {
      "id": "s_adele_of_a_function_field",
      "kind": "axiom",
      "name": "adele of a function field",
      "type_signature": "",
      "description": "An element of the restricted direct product of completions of the function field k(C) at all places (discrete valuations), used in the proof of Riemann-Roch."
    },
    {
      "id": "s_adelic_dirichlet_unit_theorem",
      "kind": "theorem",
      "name": "adelic Dirichlet unit theorem",
      "type_signature": "",
      "description": "The compactness of J_K^1/K* implies that the unit group O_K* modulo torsion is a free abelian group of rank r_1+r_2-1, where r_1 and r_2 count real and complex places."
    },
    {
      "id": "s_adelic_finiteness_of_class_number",
      "kind": "theorem",
      "name": "adelic finiteness of class number",
      "type_signature": "",
      "description": "The compactness of J_K^1/K* implies the class group Cl(K) = J_K / (K* * prod O_v*) is finite, giving the adelic proof of finiteness of the class number."
    },
    {
      "id": "s_affine_variety",
      "kind": "axiom",
      "name": "affine variety",
      "type_signature": "",
      "description": "An irreducible affine algebraic set, i.e., a set V(p) for a prime ideal p in k[x_1,...,x_n]; equivalently, one that cannot be written as a union of two proper closed subsets."
    },
    {
      "id": "s_algebraic_curve",
      "kind": "axiom",
      "name": "algebraic curve",
      "type_signature": "",
      "description": "An irreducible algebraic variety of dimension 1; equivalently, defined by a function field of transcendence degree 1 over the base field, studied via its discrete valuations."
    },
    {
      "id": "s_birational_equivalence_of_smooth_projective_curves",
      "kind": "theorem",
      "name": "birational equivalence of smooth projective curves",
      "type_signature": "",
      "description": "Two smooth projective curves are birationally equivalent if and only if they are isomorphic; a rational map from a smooth curve to a projective variety is always a morphism."
    },
    {
      "id": "s_canonical_embedding",
      "kind": "state",
      "name": "canonical embedding",
      "type_signature": "",
      "description": "For a smooth curve C of genus g >= 2 that is not hyperelliptic, the complete linear system |K_C| defines an embedding C -> P^{g-1} called the canonical embedding."
    },
    {
      "id": "s_classification_of_irreducible_curves",
      "kind": "theorem",
      "name": "classification of irreducible curves",
      "type_signature": "",
      "description": "Every irreducible curve is birationally equivalent to a smooth projective curve, unique up to isomorphism; the category of smooth projective curves is equivalent to the category of function fields of transcendence degree 1."
    },
    {
      "id": "s_compactness_of_adele_quotient",
      "kind": "theorem",
      "name": "compactness of adele quotient",
      "type_signature": "",
      "description": "The quotient A_K / K (adeles modulo the diagonally embedded global field) is compact, encoding both the strong approximation theorem and finiteness results."
    },
    {
      "id": "s_compactness_of_idele_class_group_normone",
      "kind": "theorem",
      "name": "compactness of idele class group (norm-one)",
      "type_signature": "",
      "description": "The quotient J_K^1 / K* of norm-one ideles modulo K* is compact, simultaneously encoding the finiteness of the class number and the Dirichlet unit theorem."
    },
    {
      "id": "s_complete_linear_system_determines_morphism",
      "kind": "theorem",
      "name": "complete linear system determines morphism",
      "type_signature": "",
      "description": "A base-point-free complete linear system |D| on a smooth curve C defines a morphism phi_D: C -> P^{l(D)-1}; the morphism is an embedding iff |D| separates points and tangent vectors."
    },
    {
      "id": "s_completion_of_a_valued_field",
      "kind": "state",
      "name": "completion of a valued field",
      "type_signature": "",
      "description": "The unique (up to isomorphism) complete valued field K-hat containing K as a dense subfield with the absolute value extending that of K, constructed as the quotient of Cauchy sequences by null sequences."
    },
    {
      "id": "s_decomposition_field",
      "kind": "state",
      "name": "decomposition field",
      "type_signature": "",
      "description": "The fixed field L^{D(P|p)} of the decomposition group, the largest intermediate field where p does not split further below P."
    },
    {
      "id": "s_degree_of_a_divisor",
      "kind": "axiom",
      "name": "degree of a divisor",
      "type_signature": "",
      "description": "For a divisor D = sum n_P * P on a curve, deg(D) = sum n_P; the degree map is a group homomorphism Div(C) -> Z."
    },
    {
      "id": "s_degree_of_a_morphism_of_curves",
      "kind": "axiom",
      "name": "degree of a morphism of curves",
      "type_signature": "",
      "description": "For a nonconstant morphism f: C -> C' of smooth projective curves, deg(f) = [k(C):f*k(C')], the degree of the induced function field extension."
    },
    {
      "id": "s_degree_of_a_principal_divisor_is_zero",
      "kind": "theorem",
      "name": "degree of a principal divisor is zero",
      "type_signature": "",
      "description": "For any nonzero rational function f on a smooth projective curve C, deg(div(f)) = 0; equivalently, f has as many zeros as poles counted with multiplicity."
    },
    {
      "id": "s_degree_of_a_projective_variety",
      "kind": "state",
      "name": "degree of a projective variety",
      "type_signature": "",
      "description": "For a projective variety V of dimension d, deg(V) = d! times the leading coefficient of its Hilbert polynomial; equals the number of intersection points with a generic linear subspace of complementary dimension."
    },
    {
      "id": "s_different_of_an_extension",
      "kind": "state",
      "name": "different of an extension",
      "type_signature": "",
      "description": "The ideal D_{L/K} in O_L that is the inverse of the fractional ideal {x in L : Tr_{L/K}(x*O_L) subset O_K}, measuring ramification of L/K."
    },
    {
      "id": "s_dimension_of_an_affine_variety",
      "kind": "axiom",
      "name": "dimension of an affine variety",
      "type_signature": "",
      "description": "The Krull dimension of the coordinate ring k[V], equivalently the transcendence degree of the function field k(V) over k for an irreducible variety V."
    },
    {
      "id": "s_discriminant_of_an_extension",
      "kind": "state",
      "name": "discriminant of an extension",
      "type_signature": "",
      "description": "The ideal d_{L/K} = N_{L/K}(D_{L/K}) in O_K, the norm of the different; a prime p ramifies in L/K if and only if p divides d_{L/K}."
    },
    {
      "id": "s_divisor_class_group_of_a_curve",
      "kind": "state",
      "name": "divisor class group of a curve",
      "type_signature": "",
      "description": "The quotient group Cl(C) = Div(C) / Prin(C) of divisors modulo principal divisors on C; its degree-zero part Cl^0(C) is the Jacobian."
    },
    {
      "id": "s_effective_divisor",
      "kind": "axiom",
      "name": "effective divisor",
      "type_signature": "",
      "description": "A divisor D = sum n_P * P where all coefficients n_P >= 0; written D >= 0."
    },
    {
      "id": "s_elimination_ideal",
      "kind": "state",
      "name": "elimination ideal",
      "type_signature": "",
      "description": "The l-th elimination ideal of I subset k[x_1,...,x_n] is I_l = I intersect k[x_{l+1},...,x_n], obtained by eliminating the first l variables."
    },
    {
      "id": "s_elimination_theorem",
      "kind": "theorem",
      "name": "elimination theorem",
      "type_signature": "",
      "description": "If G is a Gröbner basis for I with respect to a lexicographic order with x_1 > ... > x_n, then G intersect k[x_{l+1},...,x_n] is a Gröbner basis for the l-th elimination ideal I_l."
    },
    {
      "id": "s_elliptic_curve_genusone_curve_with_point",
      "kind": "axiom",
      "name": "elliptic curve (genus-one curve with point)",
      "type_signature": "",
      "description": "A smooth projective curve of genus 1 together with a specified rational point O, admitting a group law making it an abelian variety of dimension 1."
    },
    {
      "id": "s_equivalence_of_absolute_values",
      "kind": "axiom",
      "name": "equivalence of absolute values",
      "type_signature": "",
      "description": "Two absolute values |·|_1 and |·|_2 on K are equivalent if they define the same topology, which holds iff |·|_2 = |·|_1^s for some s > 0."
    },
    {
      "id": "s_extension_theorem",
      "kind": "theorem",
      "name": "extension theorem",
      "type_signature": "",
      "description": "Under suitable conditions on the leading coefficients, a solution of the elimination ideal I_l can be extended to a solution of I by finding values for the eliminated variables; partial converse of the elimination theorem."
    },
    {
      "id": "s_function_field_of_an_algebraic_curve",
      "kind": "axiom",
      "name": "function field of an algebraic curve",
      "type_signature": "",
      "description": "The field k(C) of rational functions on an irreducible curve C, a finitely generated extension of k of transcendence degree 1; determines the curve up to birational equivalence."
    },
    {
      "id": "s_fundamental_identity_for_valuations",
      "kind": "theorem",
      "name": "fundamental identity for valuations",
      "type_signature": "",
      "description": "For a finite extension L/K of number fields and a prime p of K, the sum of e(P_i|p)*f(P_i|p) over all primes P_i of L above p equals [L:K]."
    },
    {
      "id": "s_fundamental_theorem_for_infinite_galois_extensions",
      "kind": "theorem",
      "name": "fundamental theorem for infinite Galois extensions",
      "type_signature": "",
      "description": "For a Galois extension L/K, there is an inclusion-reversing bijection between intermediate fields K subset F subset L and closed subgroups H of Gal(L/K) in the Krull topology, via F <-> Gal(L/F) and H <-> L^H."
    },
    {
      "id": "s_generic_point_of_a_scheme",
      "kind": "state",
      "name": "generic point of a scheme",
      "type_signature": "",
      "description": "For an irreducible scheme X = Spec(R/p), the point eta = p in Spec(R) whose closure is all of X; the stalk O_{X,eta} is the function field of X."
    },
    {
      "id": "s_genus_of_an_algebraic_curve",
      "kind": "axiom",
      "name": "genus of an algebraic curve",
      "type_signature": "",
      "description": "The nonneg integer g such that Riemann's inequality l(D) >= deg(D) + 1 - g holds for all divisors D, and g is the smallest such integer; equals the geometric genus."
    },
    {
      "id": "s_geometric_dimension_noetherian_topological_space",
      "kind": "axiom",
      "name": "geometric dimension (Noetherian topological space)",
      "type_signature": "",
      "description": "The supremum of lengths of chains of irreducible closed subsets Z_0 subset Z_1 subset ... subset Z_d in a Noetherian topological space; agrees with Krull dimension for affine varieties."
    },
    {
      "id": "s_homogeneous_coordinate_ring",
      "kind": "state",
      "name": "homogeneous coordinate ring",
      "type_signature": "",
      "description": "The graded ring S(V) = k[X_0,...,X_n]/I(V) for a projective variety V, where I(V) is the homogeneous ideal of V; a graded integral domain."
    },
    {
      "id": "s_homogeneous_ideal",
      "kind": "axiom",
      "name": "homogeneous ideal",
      "type_signature": "",
      "description": "An ideal I of k[X_0,...,X_n] generated by homogeneous polynomials, equivalently I = direct sum (I intersect k[X_0,...,X_n]_d); needed to define projective algebraic sets."
    },
    {
      "id": "s_homogeneous_polynomial",
      "kind": "axiom",
      "name": "homogeneous polynomial",
      "type_signature": "",
      "description": "A polynomial F in k[X_0,...,X_n] where every monomial has the same total degree d; satisfies F(lambda*x) = lambda^d * F(x)."
    },
    {
      "id": "s_hyperelliptic_curve",
      "kind": "axiom",
      "name": "hyperelliptic curve",
      "type_signature": "",
      "description": "A smooth projective curve C of genus g >= 2 admitting a degree-2 morphism to P^1; equivalently, C has a divisor D of degree 2 with l(D) >= 2."
    },
    {
      "id": "s_hypersurface",
      "kind": "axiom",
      "name": "hypersurface",
      "type_signature": "",
      "description": "The zero locus V(f) of a single irreducible polynomial f in k[x_1,...,x_n] or a single homogeneous polynomial in projective space; has codimension 1."
    },
    {
      "id": "s_ideal_of_an_algebraic_set",
      "kind": "state",
      "name": "ideal of an algebraic set",
      "type_signature": "",
      "description": "I(V) = {f in k[x_1,...,x_n] : f(P)=0 for all P in V}, a radical ideal; by the Nullstellensatz, I(V(J)) = sqrt(J)."
    },
    {
      "id": "s_inertia_field",
      "kind": "state",
      "name": "inertia field",
      "type_signature": "",
      "description": "The fixed field L^{I(P|p)} of the inertia group, the largest intermediate field where p is unramified below P."
    },
    {
      "id": "s_infinite_galois_group",
      "kind": "state",
      "name": "infinite Galois group",
      "type_signature": "",
      "description": "The Galois group Gal(L/K) of an infinite Galois extension L/K, equipped with the Krull topology making it a profinite group isomorphic to lim_F Gal(F/K) over finite Galois subextensions F."
    },
    {
      "id": "s_intersection_multiplicity_two_curves",
      "kind": "axiom",
      "name": "intersection multiplicity (two curves)",
      "type_signature": "",
      "description": "For curves F and G in P^2 meeting at P, I(P; F,G) = dim_k O_{P^2,P}/(F,G), the dimension of the local ring quotient; it is symmetric and additive."
    },
    {
      "id": "s_intersections_in_projective_space",
      "kind": "theorem",
      "name": "intersections in projective space",
      "type_signature": "",
      "description": "Two projective varieties in P^n of dimensions r and s with r+s >= n have nonempty intersection; more precisely, every component of the intersection has dimension >= r+s-n."
    },
    {
      "id": "s_irreducible_decomposition",
      "kind": "theorem",
      "name": "irreducible decomposition",
      "type_signature": "",
      "description": "Every algebraic set V can be written uniquely as a finite union V = V_1 union ... union V_r of irreducible components (maximal irreducible closed subsets), with no V_i contained in V_j for i != j."
    },
    {
      "id": "s_linear_system_of_divisors",
      "kind": "state",
      "name": "linear system of divisors",
      "type_signature": "",
      "description": "The projective space |D| = P(L(D)) of effective divisors linearly equivalent to D on a curve C; has dimension l(D)-1 and determines maps to projective space."
    },
    {
      "id": "s_local_ring_at_a_point_of_a_variety",
      "kind": "state",
      "name": "local ring at a point of a variety",
      "type_signature": "",
      "description": "The ring O_{V,P} of rational functions regular at P, a local ring with maximal ideal m_P = {f in O_{V,P} : f(P)=0}; isomorphic to the localization of k[V] at the maximal ideal of P."
    },
    {
      "id": "s_localization_of_a_ring_at_a_prime",
      "kind": "state",
      "name": "localization of a ring at a prime",
      "type_signature": "",
      "description": "The local ring R_p obtained by inverting all elements not in a prime ideal p; its spectrum is the set of primes contained in p, modeling a neighborhood of p in Spec(R)."
    },
    {
      "id": "s_locally_ringed_space",
      "kind": "axiom",
      "name": "locally ringed space",
      "type_signature": "",
      "description": "A topological space X equipped with a sheaf of rings O_X such that every stalk O_{X,x} is a local ring; the category in which schemes live."
    },
    {
      "id": "s_monomial_order",
      "kind": "axiom",
      "name": "monomial order",
      "type_signature": "",
      "description": "A total order on the monomials of k[x_1,...,x_n] that is compatible with multiplication and is a well-ordering; examples include lexicographic, graded lexicographic, and graded reverse lexicographic orders."
    },
    {
      "id": "s_morphism_of_affine_schemes",
      "kind": "theorem",
      "name": "morphism of affine schemes",
      "type_signature": "",
      "description": "Morphisms Spec(S) -> Spec(R) of affine schemes correspond bijectively to ring homomorphisms R -> S; the functor Spec is a fully faithful contravariant functor from commutative rings to affine schemes."
    },
    {
      "id": "s_morphism_of_affine_varieties",
      "kind": "axiom",
      "name": "morphism of affine varieties",
      "type_signature": "",
      "description": "A map phi: V -> W between affine varieties given by phi(P) = (f_1(P),...,f_m(P)) for polynomials f_i; equivalently, a map inducing a k-algebra homomorphism phi*: k[W] -> k[V]."
    },
    {
      "id": "s_morphism_of_projective_varieties",
      "kind": "axiom",
      "name": "morphism of projective varieties",
      "type_signature": "",
      "description": "A map phi: V -> W between projective varieties that is locally given by homogeneous polynomials of the same degree; a continuous map in the Zariski topology."
    },
    {
      "id": "t_multivariate_division_algorithm",
      "kind": "technique",
      "name": "multivariate division algorithm",
      "function_signature": "(Polynomial f, Ordered tuple (g_1,...,g_s), Monomial order) → (Quotients a_i, Remainder r)",
      "description": "Given a polynomial f and an ordered tuple (g_1,...,g_s) with a fixed monomial order, produces f = sum a_i*g_i + r where no term of r is divisible by any LT(g_i); the remainder depends on the ordering of generators unless they form a Gröbner basis."
    },
    {
      "id": "s_nonsingular_point_of_a_variety",
      "kind": "axiom",
      "name": "nonsingular point of a variety",
      "type_signature": "",
      "description": "A point P on a variety V where the local ring O_{V,P} is a regular local ring, equivalently dim(m_P/m_P^2) = dim(V)."
    },
    {
      "id": "s_normalization_of_a_curve",
      "kind": "state",
      "name": "normalization of a curve",
      "type_signature": "",
      "description": "For an irreducible curve C, its normalization C~ is the unique smooth curve with a birational morphism C~ -> C that is an isomorphism away from the singular points of C."
    },
    {
      "id": "s_padic_absolute_value",
      "kind": "axiom",
      "name": "p-adic absolute value",
      "type_signature": "",
      "description": "The absolute value |x|_p = p^{-v_p(x)} on Q, where v_p(x) is the p-adic valuation measuring the exact power of p dividing x."
    },
    {
      "id": "s_padic_integers",
      "kind": "axiom",
      "name": "p-adic integers",
      "type_signature": "",
      "description": "The ring Z_p of p-adic integers, defined as the inverse limit of Z/p^n Z, forming a complete local ring with maximal ideal (p)."
    },
    {
      "id": "s_padic_numbers",
      "kind": "axiom",
      "name": "p-adic numbers",
      "type_signature": "",
      "description": "The field Q_p obtained as the fraction field of Z_p, or equivalently as the completion of Q with respect to the p-adic absolute value |·|_p."
    },
    {
      "id": "s_place_of_a_field",
      "kind": "axiom",
      "name": "place of a field",
      "type_signature": "",
      "description": "An equivalence class of nontrivial absolute values on a field K; for a number field, places are either finite (nonarchimedean, from primes) or infinite (archimedean, from embeddings)."
    },
    {
      "id": "s_presheaf_on_a_topological_space",
      "kind": "axiom",
      "name": "presheaf on a topological space",
      "type_signature": "",
      "description": "A contravariant functor from the category of open sets of X (with inclusions) to a target category (e.g., abelian groups, rings), assigning sections F(U) and restriction maps."
    },
    {
      "id": "s_prime_spectrum_specr",
      "kind": "axiom",
      "name": "prime spectrum Spec(R)",
      "type_signature": "",
      "description": "The set of all prime ideals of a commutative ring R, equipped with the Zariski topology where closed sets are V(I) = {p in Spec(R) : I subset p} for ideals I; the basic space underlying a scheme."
    },
    {
      "id": "s_projective_algebraic_set",
      "kind": "axiom",
      "name": "projective algebraic set",
      "type_signature": "",
      "description": "The set V(S) in P^n of common zeros of a set S of homogeneous polynomials; closed in the Zariski topology on P^n."
    },
    {
      "id": "s_projective_closure",
      "kind": "state",
      "name": "projective closure",
      "type_signature": "",
      "description": "The Zariski closure of an affine variety V subset A^n in projective space P^n under the standard embedding A^n -> P^n; obtained by homogenizing the defining polynomials."
    },
    {
      "id": "s_projective_plane_curve",
      "kind": "axiom",
      "name": "projective plane curve",
      "type_signature": "",
      "description": "The zero locus V(F) in P^2 of a nonconstant homogeneous polynomial F(X,Y,Z), considered up to scalar multiples; its degree is the degree of F."
    },
    {
      "id": "s_projective_space_pn",
      "kind": "axiom",
      "name": "projective space P^n",
      "type_signature": "",
      "description": "The set of equivalence classes of nonzero points in k^{n+1} under scalar multiplication, i.e., P^n(k) = (k^{n+1} - {0}) / k*; the natural domain for homogeneous polynomials."
    },
    {
      "id": "s_projective_variety",
      "kind": "axiom",
      "name": "projective variety",
      "type_signature": "",
      "description": "An irreducible projective algebraic set, i.e., V(p) for a homogeneous prime ideal p not equal to the irrelevant ideal; a complete algebraic variety."
    },
    {
      "id": "s_ramification_divisor",
      "kind": "state",
      "name": "ramification divisor",
      "type_signature": "",
      "description": "For a morphism f: C -> C' of curves, the divisor R = sum (e_P-1)*P on C measuring the ramification; appears in the Hurwitz formula as deg(R) = 2g-2 - deg(f)*(2g'-2)."
    },
    {
      "id": "s_rational_curve",
      "kind": "axiom",
      "name": "rational curve",
      "type_signature": "",
      "description": "A smooth projective curve of genus 0; by Riemann-Roch, it is isomorphic to P^1."
    },
    {
      "id": "s_rational_function_on_a_variety",
      "kind": "axiom",
      "name": "rational function on a variety",
      "type_signature": "",
      "description": "An equivalence class of pairs (U, f) where U is a nonempty open set of V and f is a regular function on U, with (U,f) ~ (U',f') if f=f' on U intersect U'; elements of the function field k(V)."
    },
    {
      "id": "s_rational_map_of_varieties",
      "kind": "axiom",
      "name": "rational map of varieties",
      "type_signature": "",
      "description": "An equivalence class of morphisms defined on dense open subsets of a variety V to W; a rational map V --> W may not be defined everywhere."
    },
    {
      "id": "s_regular_function_at_a_point",
      "kind": "axiom",
      "name": "regular function at a point",
      "type_signature": "",
      "description": "A rational function f on V that is defined (representable as g/h with h(P)!=0) at a point P; the set of regular functions at P forms the local ring O_{V,P}."
    },
    {
      "id": "s_residue_class_degree",
      "kind": "axiom",
      "name": "residue class degree",
      "type_signature": "",
      "description": "For an extension L/K with primes P|p, the residue class degree f(P|p) = [O_P/P : O_p/p] is the degree of the residue field extension."
    },
    {
      "id": "s_separable_closure",
      "kind": "state",
      "name": "separable closure",
      "type_signature": "",
      "description": "The maximal separable subextension K^{sep} of an algebraic closure K-bar of K; K-bar/K^{sep} is purely inseparable."
    },
    {
      "id": "s_sheaf_on_a_topological_space",
      "kind": "axiom",
      "name": "sheaf on a topological space",
      "type_signature": "",
      "description": "A presheaf F on X satisfying: (1) if s|_{U_i}=0 for all U_i in an open cover of U, then s=0 (locality); (2) if s_i in F(U_i) agree on overlaps, they glue to s in F(U) (gluing)."
    },
    {
      "id": "s_singular_point_of_a_variety",
      "kind": "axiom",
      "name": "singular point of a variety",
      "type_signature": "",
      "description": "A point P on a variety V where dim(m_P/m_P^2) > dim(V), equivalently where the Jacobian matrix does not have maximal rank; the locus of singular points is a proper closed subset."
    },
    {
      "id": "s_splitting_of_primes_in_extensions",
      "kind": "state",
      "name": "splitting of primes in extensions",
      "type_signature": "",
      "description": "For a prime p of O_K in an extension L/K, the factorization p*O_L = P_1^{e_1} ... P_g^{e_g}; primes can split, remain inert, or ramify depending on the e_i and f_i."
    },
    {
      "id": "s_structure_sheaf_on_specr",
      "kind": "state",
      "name": "structure sheaf on Spec(R)",
      "type_signature": "",
      "description": "The sheaf O on Spec(R) with O(D(f)) = R_f (localization at f) and stalks O_p = R_p (localization at prime p); makes (Spec(R), O) into a locally ringed space."
    },
    {
      "id": "s_tangent_space_zariski",
      "kind": "state",
      "name": "tangent space (Zariski)",
      "type_signature": "",
      "description": "The Zariski tangent space at a point P of a variety V is (m_P/m_P^2)*, the dual of the cotangent space m_P/m_P^2 of the local ring O_{V,P}; its dimension equals dim(V) iff P is nonsingular."
    },
    {
      "id": "s_tensor_product_decomposition_of_completions",
      "kind": "theorem",
      "name": "tensor product decomposition of completions",
      "type_signature": "",
      "description": "For a finite separable extension L/K and a place v of K, K_v tensor_K L is isomorphic to the product of completions L_w over all places w of L above v."
    },
    {
      "id": "s_totally_ramified_extension",
      "kind": "axiom",
      "name": "totally ramified extension",
      "type_signature": "",
      "description": "An extension L/K of valued fields where e(P|p) = [L:K] and f(P|p) = 1, so the entire degree is accounted for by ramification."
    },
    {
      "id": "s_unramified_extension",
      "kind": "axiom",
      "name": "unramified extension",
      "type_signature": "",
      "description": "An extension L/K of valued fields where e(P|p)=1 and the residue field extension is separable, so ramification index is trivial."
    },
    {
      "id": "s_zeta_function_of_a_variety_over_a_finite_field",
      "kind": "state",
      "name": "zeta function of a variety over a finite field",
      "type_signature": "",
      "description": "Z(V,t) = exp(sum_{m>=1} |V(F_{q^m})| * t^m / m), a formal power series encoding point counts of V over all finite extensions of F_q; rational by the Weil conjectures."
    },
    {
      "id": "s_ideal_sum",
      "kind": "axiom",
      "name": "Sum of ideals",
      "type_signature": "",
      "description": "The sum 𝔞 + 𝔟 of two ideals is the smallest ideal containing both, equal to {a + b : a ∈ 𝔞, b ∈ 𝔟}."
    },
    {
      "id": "s_ideal_product",
      "kind": "axiom",
      "name": "Product of ideals",
      "type_signature": "",
      "description": "The product 𝔞𝔟 of two ideals is the ideal generated by all products ab with a ∈ 𝔞, b ∈ 𝔟."
    },
    {
      "id": "s_ideal_quotient",
      "kind": "axiom",
      "name": "Ideal quotient (colon ideal)",
      "type_signature": "(𝔞 : 𝔟) = {x ∈ A : x𝔟 ⊆ 𝔞}",
      "description": "The ideal quotient (𝔞 : 𝔟) is the set of all ring elements x such that x𝔟 ⊆ 𝔞, forming an ideal of A."
    },
    {
      "id": "s_coprime_ideals",
      "kind": "axiom",
      "name": "Coprime ideals",
      "type_signature": "",
      "description": "Two ideals 𝔞, 𝔟 in a commutative ring are coprime (comaximal) if 𝔞 + 𝔟 = (1)."
    },
    {
      "id": "s_prime_avoidance_lemma",
      "kind": "theorem",
      "name": "Prime avoidance lemma",
      "type_signature": "",
      "description": "If an ideal 𝔞 is contained in a finite union of prime ideals 𝔭₁ ∪ ··· ∪ 𝔭ₙ, then 𝔞 ⊆ 𝔭ᵢ for some i."
    },
    {
      "id": "s_extension_and_contraction_of_ideals",
      "kind": "axiom",
      "name": "Extension and contraction of ideals",
      "type_signature": "",
      "description": "For a ring homomorphism f: A → B, the extension 𝔞ᵉ of an ideal 𝔞 ⊆ A is the ideal 𝔞B generated by f(𝔞), and the contraction 𝔟ᶜ of an ideal 𝔟 ⊆ B is f⁻¹(𝔟)."
    },
    {
      "id": "s_jacobson_radical_characterization",
      "kind": "theorem",
      "name": "Jacobson radical characterization",
      "type_signature": "",
      "description": "An element x belongs to the Jacobson radical J(A) if and only if 1 − xy is a unit in A for every y ∈ A."
    },
    {
      "id": "s_characterization_of_local_rings",
      "kind": "theorem",
      "name": "Characterization of local rings",
      "type_signature": "",
      "description": "A ring is local if and only if its set of non-units forms an ideal, equivalently if it has a unique maximal ideal."
    },
    {
      "id": "s_radical_equals_intersection_of_primes_containing_ideal",
      "kind": "theorem",
      "name": "Radical equals intersection of primes containing ideal",
      "type_signature": "",
      "description": "The radical √𝔞 of an ideal 𝔞 equals the intersection of all prime ideals containing 𝔞."
    },
    {
      "id": "s_restriction_of_scalars",
      "kind": "axiom",
      "name": "Restriction of scalars",
      "type_signature": "",
      "description": "Given a ring homomorphism f: A → B and a B-module N, restriction of scalars gives N the structure of an A-module via a·n = f(a)·n."
    },
    {
      "id": "s_algebra_over_a_ring",
      "kind": "axiom",
      "name": "Algebra over a ring",
      "type_signature": "",
      "description": "An A-algebra is a ring B together with a ring homomorphism f: A → B, making B simultaneously an A-module and a ring compatibly."
    },
    {
      "id": "s_flatness_ideal_criterion",
      "kind": "theorem",
      "name": "Ideal-theoretic characterization of flatness",
      "type_signature": "",
      "description": "An A-module M is flat if and only if for every ideal 𝔞 of A, the natural map 𝔞 ⊗_A M → M is injective."
    },
    {
      "id": "s_ring_of_fractions",
      "kind": "axiom",
      "name": "Ring of fractions",
      "type_signature": "S⁻¹A",
      "description": "For a multiplicative subset S of a ring A, the ring of fractions S⁻¹A consists of equivalence classes of pairs (a, s) with a ∈ A, s ∈ S, under the relation (a,s) ~ (b,t) iff u(at − bs) = 0 for some u ∈ S."
    },
    {
      "id": "s_module_of_fractions",
      "kind": "axiom",
      "name": "Module of fractions",
      "type_signature": "S⁻¹M",
      "description": "For a multiplicative subset S and an A-module M, the module of fractions S⁻¹M consists of equivalence classes m/s with the natural S⁻¹A-module structure, isomorphic to S⁻¹A ⊗_A M."
    },
    {
      "id": "s_local_property",
      "kind": "axiom",
      "name": "Local property of modules",
      "type_signature": "",
      "description": "A property P of modules or ring elements is local if it holds globally precisely when it holds after localization at every prime (or every maximal) ideal."
    },
    {
      "id": "s_flatness_is_a_local_property",
      "kind": "theorem",
      "name": "Flatness is a local property",
      "type_signature": "",
      "description": "An A-module M is flat if and only if M_𝔭 is a flat A_𝔭-module for every prime ideal 𝔭 of A."
    },
    {
      "id": "s_prime_correspondence_under_localization",
      "kind": "theorem",
      "name": "Prime correspondence under localization",
      "type_signature": "",
      "description": "The prime ideals of S⁻¹A are in inclusion-preserving bijection with the prime ideals of A that do not meet S, via 𝔭 ↦ S⁻¹𝔭."
    },
    {
      "id": "s_integral_closure_is_a_subring",
      "kind": "theorem",
      "name": "Integral closure is a subring",
      "type_signature": "",
      "description": "The set of elements in a ring extension B/A that are integral over A forms a subring of B (the integral closure of A in B)."
    },
    {
      "id": "s_integral_element_equivalences",
      "kind": "theorem",
      "name": "Equivalences for integral elements",
      "type_signature": "",
      "description": "An element x ∈ B is integral over A iff A[x] is a finitely generated A-module, iff A[x] is contained in a finitely generated A-submodule of B, iff there exists a faithful A[x]-module finitely generated over A."
    },
    {
      "id": "s_valuation_ring_characterization",
      "kind": "theorem",
      "name": "Characterization of valuation rings",
      "type_signature": "",
      "description": "An integral domain V with fraction field K is a valuation ring if and only if for every x ∈ K×, either x ∈ V or x⁻¹ ∈ V, equivalently if its ideals are totally ordered by inclusion."
    },
    {
      "id": "s_integral_closure_via_valuation_rings",
      "kind": "theorem",
      "name": "Integral closure via valuation rings",
      "type_signature": "",
      "description": "The integral closure of an integral domain A in its field of fractions equals the intersection of all valuation rings of K containing A."
    },
    {
      "id": "s_noetherian_characterization_exact_sequences",
      "kind": "theorem",
      "name": "Noetherian characterization via exact sequences",
      "type_signature": "",
      "description": "In a short exact sequence 0 → M' → M → M'' → 0 of A-modules, M is Noetherian if and only if both M' and M'' are Noetherian."
    },
    {
      "id": "s_hilbert_basis_theorem_power_series",
      "kind": "theorem",
      "name": "Hilbert basis theorem for power series rings",
      "type_signature": "",
      "description": "If A is a Noetherian ring, then the formal power series ring A[[x]] is also Noetherian."
    },
    {
      "id": "s_irreducible_ideal",
      "kind": "axiom",
      "name": "Irreducible ideal",
      "type_signature": "",
      "description": "An ideal 𝔞 is irreducible if 𝔞 = 𝔟 ∩ 𝔠 implies 𝔞 = 𝔟 or 𝔞 = 𝔠; it cannot be written as a non-trivial intersection of two strictly larger ideals."
    },
    {
      "id": "s_irreducible_ideals_are_primary_in_noetherian_rings",
      "kind": "theorem",
      "name": "Irreducible ideals are primary in Noetherian rings",
      "type_signature": "",
      "description": "In a Noetherian ring, every irreducible ideal is primary."
    },
    {
      "id": "s_every_ideal_is_finite_intersection_of_irreducibles",
      "kind": "theorem",
      "name": "Every ideal is a finite intersection of irreducible ideals",
      "type_signature": "",
      "description": "In a Noetherian ring, every ideal can be expressed as a finite intersection of irreducible ideals."
    },
    {
      "id": "s_symbolic_power_of_a_prime",
      "kind": "axiom",
      "name": "Symbolic power of a prime ideal",
      "type_signature": "𝔭^(n)",
      "description": "The n-th symbolic power 𝔭^(n) of a prime ideal 𝔭 is the 𝔭-primary component of 𝔭ⁿ, equivalently 𝔭^(n) = 𝔭ⁿA_𝔭 ∩ A."
    },
    {
      "id": "s_artinian_ring_has_dimension_zero",
      "kind": "theorem",
      "name": "Artinian rings have Krull dimension zero",
      "type_signature": "",
      "description": "A commutative ring is Artinian if and only if it is Noetherian and has Krull dimension zero (every prime ideal is maximal)."
    },
    {
      "id": "s_structure_theorem_for_artinian_rings",
      "kind": "theorem",
      "name": "Structure theorem for Artinian rings",
      "type_signature": "",
      "description": "Every commutative Artinian ring is uniquely (up to isomorphism) a finite direct product of Artinian local rings."
    },
    {
      "id": "s_artinian_ring_finitely_many_maximal_ideals",
      "kind": "theorem",
      "name": "Artinian ring has finitely many maximal ideals",
      "type_signature": "",
      "description": "A commutative Artinian ring has only finitely many maximal ideals."
    },
    {
      "id": "s_dvr_characterizations",
      "kind": "theorem",
      "name": "Characterizations of discrete valuation rings",
      "type_signature": "",
      "description": "A Noetherian local domain of dimension 1 is a DVR iff it is integrally closed, iff its maximal ideal is principal, iff it is a regular local ring of dimension 1."
    },
    {
      "id": "s_dedekind_domain_characterizations",
      "kind": "theorem",
      "name": "Characterizations of Dedekind domains",
      "type_signature": "",
      "description": "A Noetherian domain of dimension ≤ 1 is Dedekind iff it is integrally closed, iff every primary ideal is a prime power, iff every localization at a nonzero prime is a DVR."
    },
    {
      "id": "s_filtered_module",
      "kind": "axiom",
      "name": "Filtered module",
      "type_signature": "",
      "description": "A module M over a filtered ring A equipped with a decreasing sequence of submodules M = M₀ ⊇ M₁ ⊇ ··· compatible with the filtration on A."
    },
    {
      "id": "s_completion_is_exact_on_fg_modules",
      "kind": "theorem",
      "name": "Completion is exact on finitely generated modules",
      "type_signature": "",
      "description": "For a Noetherian ring A with 𝔞-adic topology, the completion functor M ↦ M̂ is exact on the category of finitely generated A-modules."
    },
    {
      "id": "s_flatness_of_completion",
      "kind": "theorem",
      "name": "Flatness of completion",
      "type_signature": "",
      "description": "For a Noetherian ring A, the 𝔞-adic completion Â is a flat A-algebra."
    },
    {
      "id": "s_completion_of_noetherian_ring_is_noetherian",
      "kind": "theorem",
      "name": "Completion of a Noetherian ring is Noetherian",
      "type_signature": "",
      "description": "The 𝔞-adic completion of a Noetherian ring is again Noetherian."
    },
    {
      "id": "s_height_of_a_prime_ideal",
      "kind": "axiom",
      "name": "Height of a prime ideal",
      "type_signature": "ht(𝔭)",
      "description": "The height of a prime ideal 𝔭 is the supremum of lengths of chains of prime ideals 𝔭₀ ⊊ 𝔭₁ ⊊ ··· ⊊ 𝔭ₙ = 𝔭 descending from 𝔭."
    },
    {
      "id": "s_coheight_of_a_prime_ideal",
      "kind": "axiom",
      "name": "Coheight of a prime ideal",
      "type_signature": "coht(𝔭) = dim(A/𝔭)",
      "description": "The coheight of a prime ideal 𝔭 in a ring A is the Krull dimension of A/𝔭, the supremum of lengths of chains of primes ascending from 𝔭."
    },
    {
      "id": "s_regular_local_ring_is_integral_domain",
      "kind": "theorem",
      "name": "Regular local ring is an integral domain",
      "type_signature": "",
      "description": "Every regular local ring is an integral domain."
    },
    {
      "id": "s_dimension_inequality_for_extensions",
      "kind": "theorem",
      "name": "Dimension inequality for ring extensions",
      "type_signature": "",
      "description": "If A ⊆ B are Noetherian domains and 𝔮 is a prime of B lying over 𝔭 in A, then ht(𝔮) + tr.deg(κ(𝔮)/κ(𝔭)) ≤ ht(𝔭) + tr.deg(B/A)."
    },
    {
      "id": "t_primary_decomposition_technique",
      "kind": "technique",
      "name": "Primary decomposition technique",
      "function_signature": "(Ideal or submodule in a Noetherian ring) → (Intersection of primary components with known associated primes)",
      "description": "Decomposing an ideal or submodule into primary components to study its associated primes and reduce problems to the primary case."
    },
    {
      "id": "t_integral_closure_technique",
      "kind": "technique",
      "name": "Integral closure technique",
      "function_signature": "(Ring extension A ⊆ B, algebraic/finiteness conditions) → (Properties of the integral closure of A in B)",
      "description": "Passing to the integral closure to improve ring-theoretic properties while preserving dimension and prime structure."
    },
    {
      "id": "t_noetherian_induction",
      "kind": "technique",
      "name": "Noetherian induction",
      "function_signature": "(Property P on ideals of a Noetherian ring) → (P holds for all ideals by induction on the poset of ideals)",
      "description": "Proving a statement for all ideals of a Noetherian ring by assuming it fails and taking a maximal counterexample via the ACC."
    },
    {
      "id": "t_completion_technique",
      "kind": "technique",
      "name": "Completion technique",
      "function_signature": "(Local ring (A, 𝔪), local property to prove) → (Result via completed ring Â and its improved structure)",
      "description": "Passing to the 𝔞-adic completion of a local ring to exploit completeness, Hensel's lemma, and Cohen structure theorems."
    },
    {
      "id": "t_graded_ring_technique",
      "kind": "technique",
      "name": "Graded/associated-graded technique",
      "function_signature": "(Filtered ring/module with 𝔞-adic filtration) → (Properties of gr_𝔞(A) transferred back)",
      "description": "Passing from a filtered ring or module to its associated graded object to reduce questions about a local ring to questions about a polynomial ring."
    },
    {
      "id": "t_hilbert_function_method",
      "kind": "technique",
      "name": "Hilbert function method",
      "function_signature": "(Graded module or local ring with 𝔪-primary ideal) → (Dimension, multiplicity, and growth data from the Hilbert polynomial)",
      "description": "Using the Hilbert function or Hilbert-Samuel polynomial to extract numerical invariants from graded or filtered algebraic structures."
    },
    {
      "id": "t_determinant_trick",
      "kind": "technique",
      "name": "Determinant trick",
      "function_signature": "(Finitely generated module M, endomorphism φ with φ(M) ⊆ IM) → (Monic relation φⁿ + a₁φⁿ⁻¹ + ··· + aₙ = 0 with aᵢ ∈ Iⁱ)",
      "description": "Applying the Cayley-Hamilton theorem to an endomorphism of a finitely generated module to produce integral dependence or annihilation relations."
    },
    {
      "id": "s_residue_field",
      "kind": "state",
      "name": "Residue field",
      "type_signature": "κ(𝔭) = R_𝔭/𝔭R_𝔭",
      "description": "The residue field of a prime ideal 𝔭 in a commutative ring R, defined as the quotient of the localization R_𝔭 by its maximal ideal 𝔭R_𝔭."
    },
    {
      "id": "s_idempotents_and_connected_components_of_spec",
      "kind": "theorem",
      "name": "Idempotents and connected components of Spec",
      "type_signature": "",
      "description": "The connected components of Spec(R) correspond bijectively to primitive idempotents of R; R decomposes as a product of rings iff Spec(R) is disconnected."
    },
    {
      "id": "s_prime_filtration",
      "kind": "state",
      "name": "Prime filtration of a module",
      "type_signature": "",
      "description": "A chain 0 = M₀ ⊂ M₁ ⊂ ··· ⊂ Mₙ = M with each successive quotient Mᵢ/Mᵢ₋₁ ≅ R/𝔭ᵢ for prime ideals 𝔭ᵢ; exists for every finitely generated module over a Noetherian ring."
    },
    {
      "id": "s_finiteness_of_associated_primes",
      "kind": "theorem",
      "name": "Finiteness of associated primes",
      "type_signature": "",
      "description": "For a finitely generated module M over a Noetherian ring R, the set Ass(M) of associated primes is finite."
    },
    {
      "id": "s_zero_divisors_equal_union_of_associated_primes",
      "kind": "theorem",
      "name": "Zero divisors equal union of associated primes",
      "type_signature": "",
      "description": "For a finitely generated module M over a Noetherian ring, the set of zero divisors on M equals the union of the associated primes of M."
    },
    {
      "id": "s_ufd_implies_integrally_closed",
      "kind": "theorem",
      "name": "UFD implies integrally closed",
      "type_signature": "",
      "description": "Every unique factorization domain is integrally closed in its field of fractions."
    },
    {
      "id": "s_zariskis_lemma",
      "kind": "theorem",
      "name": "Zariski's lemma",
      "type_signature": "",
      "description": "If k is a field and K is a finitely generated k-algebra that is also a field, then K is a finite (algebraic) extension of k."
    },
    {
      "id": "s_filtration_of_a_module",
      "kind": "axiom",
      "name": "Filtration of a module",
      "type_signature": "",
      "description": "A descending chain of submodules M = M₀ ⊇ M₁ ⊇ M₂ ⊇ ··· compatible with the ring filtration; the I-adic filtration Mₙ = IⁿM is the primary example."
    },
    {
      "id": "s_stable_filtration",
      "kind": "state",
      "name": "Stable filtration (I-stable)",
      "type_signature": "",
      "description": "An I-filtration {Mₙ} is I-stable if Mₙ₊₁ = I·Mₙ for all sufficiently large n, equivalently the Rees module ⊕Mₙ is finitely generated over R[It]."
