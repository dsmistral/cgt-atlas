    },
    {
      "id": "s_continuity_from_below_measures",
      "kind": "theorem",
      "name": "Continuity from below for measures",
      "type_signature": "",
      "description": "If E_1 ⊂ E_2 ⊂ ··· is an increasing sequence of measurable sets, then μ(⋃ E_j) = lim μ(E_j)."
    },
    {
      "id": "s_continuity_from_above_measures",
      "kind": "theorem",
      "name": "Continuity from above for measures",
      "type_signature": "",
      "description": "If E_1 ⊃ E_2 ⊃ ··· is a decreasing sequence of measurable sets with μ(E_1) < ∞, then μ(⋂ E_j) = lim μ(E_j)."
    },
    {
      "id": "s_complete_measure",
