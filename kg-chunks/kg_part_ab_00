      "id": "s_liouville_property_recurrent_mc",
      "kind": "theorem",
      "type_signature": "",
      "name": "Liouville property for recurrent Markov chains",
      "description": "An irreducible recurrent Markov chain has no non-constant bounded harmonic functions; every bounded function h with Ph = h is constant."
    },
    {
      "id": "t_discrete_dirichlet_problem",
      "kind": "technique",
      "function_signature": "(MC, domain D, boundary function f) → (Harmonic function on D with boundary values f)",
      "name": "Discrete Dirichlet problem",
      "description": "Solves for the unique function h harmonic on D with h = f on ∂D via h(x) = E_x[f(X_{τ_{∂D}})]; the probabilistic solution of discrete boundary value problems."
    },
    {
      "id": "s_superharmonic_optional_stopping",
      "kind": "theorem",
      "type_signature": "",
      "name": "Superharmonic functions and optional stopping",
      "description": "If h is superharmonic (Ph ≤ h) for a Markov chain, then h(X_n) is a supermartingale; optional stopping yields h(x) ≥ E_x[h(X_τ)] for stopping times τ."
    },
    {
      "id": "s_potential_kernel_recurrent_mc",
      "kind": "state",
      "type_signature": "(Recurrent MC, x, y) → ℝ",
      "name": "Potential kernel (deviation matrix) for recurrent chains",
      "description": "The deviation matrix A(x,y) = Σ_{n=0}^∞ [p^{(n)}(x,y) − π(y)], measuring cumulative deviation from equilibrium; the analogue of the Green function in the recurrent setting."
    },
    {
      "id": "s_potential_of_charge_mc",
      "kind": "state",
      "type_signature": "(Recurrent MC, signed measure ν) → Function",
      "name": "Potential of a charge (recurrent chain)",
      "description": "For a signed measure ν with ν(E) = 0, the potential Uν(x) = Σ_y A(x,y)ν(y) where A is the deviation matrix; the discrete analogue of the potential of a balanced charge."
    },
    {
      "id": "s_green_kernel_transient_mc",
      "kind": "state",
      "type_signature": "(Transient MC, x, y) → [0,∞)",
      "name": "Green kernel for transient Markov chains",
      "description": "G(x,y) = Σ_{n=0}^∞ p^{(n)}(x,y) = E_x[number of visits to y], finite for transient chains; the kernel for the potential operator Gf(x) = Σ_y G(x,y)f(y)."
    },
    {
      "id": "s_riesz_decomposition_discrete_mc",
      "kind": "theorem",
      "type_signature": "",
      "name": "Riesz decomposition for Markov chains",
      "description": "Every non-negative superharmonic function on a transient Markov chain decomposes uniquely as h = Gν + f where Gν is a potential (ν ≥ 0) and f is harmonic."
    },
    {
      "id": "s_excessive_function_mc",
      "kind": "axiom",
      "type_signature": "(MC, α) → (E → [0,∞])",
      "name": "Excessive function (α-excessive)",
      "description": "A non-negative function f satisfying αPf ≤ f and α^n P^n f(x) → f(x) for all x; when α = 1, these are the non-negative superharmonic functions with a regularity condition."
    },
    {
      "id": "s_excessive_function_characterization",
      "kind": "theorem",
      "type_signature": "",
      "name": "Characterization of excessive functions",
      "description": "A non-negative function f is excessive iff Pf ≤ f and P^n f → f pointwise; equivalently, f is the pointwise limit of an increasing sequence of potentials."
    },
    {
      "id": "s_minimum_principle_excessive",
      "kind": "theorem",
      "type_signature": "",
      "name": "Minimum principle for excessive functions",
      "description": "If an excessive function f dominates a potential g outside a finite set, then f ≥ g everywhere; the dual of the maximum principle for subharmonic functions."
    },
    {
      "id": "s_domination_principle_mc",
      "kind": "theorem",
      "type_signature": "",
      "name": "Domination principle for potentials",
      "description": "If Gμ ≤ Gν on the support of μ, then Gμ ≤ Gν everywhere; the discrete analogue of the classical domination principle in potential theory."
    },
    {
      "id": "s_cone_of_excessive_functions",
      "kind": "state",
      "type_signature": "MC → Cone",
      "name": "Cone of excessive functions",
      "description": "The set of all excessive functions for a Markov chain, forming a convex cone closed under pointwise infima and increasing limits; the fundamental object of probabilistic potential theory."
    },
    {
      "id": "s_energy_of_measure_mc",
      "kind": "axiom",
      "type_signature": "(MC, measure μ) → [0,∞]",
      "name": "Energy of a measure (discrete potential theory)",
      "description": "ℰ(μ) = ⟨μ, Gμ⟩ = Σ_{x,y} μ(x)G(x,y)μ(y), the mutual energy of measure μ under the Green kernel G of a transient chain."
    },
    {
      "id": "s_dirichlet_form_discrete",
      "kind": "axiom",
      "type_signature": "(MC, f) → [0,∞)",
      "name": "Dirichlet form (discrete Markov chain)",
      "description": "The quadratic form ℰ(f,f) = (1/2) Σ_{x,y} π(x)p(x,y)(f(x)−f(y))² measuring energy dissipation; for reversible chains, connected to the spectral gap."
    },
    {
      "id": "s_capacity_discrete_mc",
      "kind": "state",
      "type_signature": "(MC, Set A) → [0,∞)",
      "name": "Capacity of a set (discrete Markov chain)",
      "description": "Cap(A) = Σ_{x∈A} e_A(x) where e_A is the equilibrium measure; measures the ease with which the chain hits A and characterizes transience vs. recurrence."
    },
    {
      "id": "s_equilibrium_measure_mc",
      "kind": "state",
      "type_signature": "(MC, Set A) → Measure",
      "name": "Equilibrium measure (discrete potential theory)",
      "description": "The unique measure e_A on A such that Ge_A(x) = P_x(T_A < ∞) for transient chains; the charge distribution on A generating the hitting probability as its potential."
    },
    {
      "id": "s_equilibrium_potential_mc",
      "kind": "state",
      "type_signature": "(MC, Set A) → Function",
      "name": "Equilibrium potential (discrete Markov chain)",
      "description": "h_A(x) = P_x(T_A < ∞) = Ge_A(x); an excessive function equal to 1 on A, the unique smallest excessive function dominating 1_A."
    },
    {
      "id": "s_capacity_transience_criterion",
      "kind": "theorem",
      "type_signature": "",
      "name": "Capacity and transience criterion",
      "description": "A state is transient if and only if it has positive capacity; a Markov chain is transient iff Cap({x}) > 0 for some (hence all, in the irreducible case) states."
    },
    {
      "id": "s_energy_principle_mc",
      "kind": "theorem",
      "type_signature": "",
      "name": "Energy principle (discrete potential theory)",
      "description": "The energy ℰ(μ) = ⟨μ, Gμ⟩ is minimized over probability measures on A by the normalized equilibrium measure; the minimum equals 1/Cap(A)."
    },
    {
      "id": "t_balayage_mc",
      "kind": "technique",
      "function_signature": "(Excessive function f, set A) → (Réduite R_A f)",
      "name": "Balayage (sweeping) for Markov chains",
      "description": "Sweeps an excessive function f onto a set A, producing the réduite R_A f(x) = E_x[f(X_{T_A})], the smallest excessive function dominating f on A."
    },
    {
      "id": "s_reduite_mc",
      "kind": "state",
      "type_signature": "(MC, excessive f, set A) → Excessive function",
      "name": "Réduite (reduced function) for Markov chains",
      "description": "R_A f(x) = inf{g(x) : g excessive, g ≥ f on A}, the smallest excessive function that dominates f on A; equals E_x[f(X_{T_A})]."
    },
    {
      "id": "s_balayage_of_measure_mc",
      "kind": "state",
      "type_signature": "(MC, measure μ, set A) → Measure",
      "name": "Balayage of a measure (discrete potential theory)",
      "description": "The swept measure μ^A representing the distribution of the chain started with measure μ and stopped upon hitting A."
    },
    {
      "id": "s_balayage_principle_mc",
      "kind": "theorem",
      "type_signature": "",
      "name": "Balayage principle for Markov chains",
      "description": "For every excessive function f and set A, the réduite R_A f is excessive, equals f on A (up to a polar set), and is harmonic on A^c."
    },
    {
      "id": "s_hunt_balayage_theorem",
      "kind": "theorem",
      "type_signature": "",
      "name": "Hunt's balayage theorem",
      "description": "Every excessive function is the supremum of potentials of measures it dominates; gives a complete representation theory for the cone of excessive functions."
    },
    {
      "id": "s_ctmc_definition",
      "kind": "axiom",
      "type_signature": "(E, Q-matrix) → StochasticProcess",
      "name": "Continuous-time Markov chain (CTMC)",
      "description": "A continuous-time stochastic process (X_t)_{t≥0} on a countable state space satisfying the Markov property with time-homogeneous transition rates given by a Q-matrix."
    },
    {
      "id": "s_transition_semigroup_ctmc",
      "kind": "axiom",
      "type_signature": "CTMC → {P(t) : t ≥ 0}",
      "name": "Transition semigroup of a CTMC",
      "description": "The family {P(t)}_{t≥0} of transition matrices satisfying P(s+t) = P(s)P(t), P(0) = I, encoding transition probabilities of a continuous-time Markov chain."
    },
    {
      "id": "s_holding_time_ctmc",
      "kind": "state",
      "type_signature": "State → Exp(q_i)",
      "name": "Holding time of a CTMC",
      "description": "The time spent in state i before jumping, exponentially distributed with rate q_i = -q_{ii}; the memoryless property ensures the Markov property in continuous time."
    },
    {
      "id": "s_jump_chain_ctmc",
      "kind": "state",
      "type_signature": "CTMC → Discrete MC",
      "name": "Jump chain (embedded chain) of a CTMC",
      "description": "The discrete-time Markov chain recording successive states visited by the CTMC, with transition probabilities p̃(i,j) = q_{ij}/q_i; together with holding times, determines the CTMC."
    },
    {
      "id": "s_minimal_solution_ctmc",
      "kind": "state",
      "type_signature": "Q-matrix → Transition semigroup",
      "name": "Minimal solution of the Kolmogorov equations",
      "description": "The smallest non-negative solution to both Kolmogorov equations, constructed via successive approximations; honest iff no explosion occurs."
    },
    {
      "id": "s_explosion_ctmc",
      "kind": "state",
      "type_signature": "CTMC → Event",
      "name": "Explosion of a CTMC",
      "description": "The event that infinitely many jumps occur in finite time (ζ = lim J_n < ∞); when explosion occurs, the minimal chain is dishonest (Σ_y p_t(x,y) < 1)."
    },
    {
      "id": "s_non_explosion_criterion_ctmc",
      "kind": "theorem",
      "type_signature": "",
      "name": "Non-explosion criterion for CTMCs",
      "description": "A CTMC is non-explosive if Σ_n 1/q_{Y_n} = ∞ a.s.; sufficient conditions include uniform boundedness of rates or existence of a Lyapunov function f with Qf ≤ cf."
    },
    {
      "id": "t_uniformization_ctmc",
      "kind": "technique",
      "function_signature": "(CTMC with bounded rates) → (Poisson-subordinated discrete chain)",
      "name": "Uniformization of a CTMC",
      "description": "Represents a CTMC with bounded rates as P(t) = e^{-qt} Σ (qt)^n/n! · P̃^n where P̃ = I + Q/q; reduces analysis to a Poisson-subordinated discrete chain."
    },
    {
      "id": "s_resolvent_as_lambda_potential",
      "kind": "state",
      "type_signature": "(MarkovProcess, λ > 0) → Kernel",
      "name": "Resolvent as λ-potential kernel",
      "description": "R_λ(x,y) = ∫_0^∞ e^{-λt} p(t,x,y) dt; the λ-potential kernel generalizing the Green function, with R_λ f = E_x[∫_0^∞ e^{-λt} f(X_t) dt]."
    },
    {
      "id": "s_lambda_excessive_function",
      "kind": "axiom",
      "type_signature": "(MarkovProcess, λ ≥ 0) → (E → [0,∞])",
      "name": "λ-excessive function",
      "description": "A non-negative function f with e^{-λt} P_t f ≤ f for all t ≥ 0 and e^{-λt} P_t f → f as t ↓ 0; the natural class for resolvent potential theory."
    },
    {
      "id": "s_resolvent_characterization_excessive",
      "kind": "theorem",
      "type_signature": "",
      "name": "Resolvent characterization of λ-excessive functions",
      "description": "A non-negative function f is λ-excessive iff αR_{λ+α} f ↑ f as α → ∞; equivalently, f is the pointwise supremum of λ-potentials."
    },
    {
      "id": "s_potential_operator_continuous",
      "kind": "state",
      "type_signature": "(TransientProcess, f) → Function",
      "name": "Potential operator for continuous-time processes",
      "description": "Gf(x) = E_x[∫_0^∞ f(X_t) dt] = lim_{λ↓0} R_λ f(x); the continuous-time analogue of the discrete Green kernel, defined for transient processes."
    },
    {
      "id": "s_recovery_semigroup_from_resolvent",
      "kind": "theorem",
      "type_signature": "",
      "name": "Recovery of semigroup from resolvent",
      "description": "The transition semigroup is uniquely determined by the resolvent family via P_t f = lim (nR_{n/t})^{[nt]} f or Laplace inversion; content of the Hille-Yosida generation theorem."
    },
    {
      "id": "s_recurrence_transience_ctmc",
      "kind": "axiom",
      "type_signature": "CTMC → Prop",
      "name": "Recurrence and transience for CTMCs",
      "description": "A CTMC state is recurrent if ∫_0^∞ p_t(x,x) dt = ∞ (returns a.s.) and transient if the integral is finite; recurrence/transience are class properties."
    },
    {
      "id": "s_invariant_measure_ctmc",
      "kind": "axiom",
      "type_signature": "CTMC → σ-finite measure",
      "name": "Invariant measure for a CTMC",
      "description": "A σ-finite measure π satisfying πQ = 0, equivalently πP(t) = π for all t ≥ 0; unique up to scalar for irreducible recurrent CTMCs."
    },
    {
      "id": "s_ergodic_theorem_ctmc",
      "kind": "theorem",
      "type_signature": "",
      "name": "Ergodic theorem for CTMCs",
      "description": "For an irreducible positive recurrent CTMC with stationary distribution π, (1/t)∫_0^t f(X_s) ds → Σ_x f(x)π(x) a.s. and p_t(x,y) → π(y) as t → ∞."
    },
    {
      "id": "s_continuous_time_green_function",
      "kind": "state",
      "type_signature": "(Transient CTMC, x, y) → [0,∞)",
      "name": "Green function for continuous-time processes",
      "description": "G(x,y) = ∫_0^∞ p_t(x,y) dt = E_x[total time at y]; the continuous-time Green function, finite when the process is transient."
    },
    {
      "id": "s_riesz_decomposition_continuous_mc",
      "kind": "theorem",
      "type_signature": "",
      "name": "Riesz decomposition for continuous-time processes",
      "description": "Every non-negative excessive function for a transient process decomposes uniquely as f = Gμ + h where Gμ is a potential and h is harmonic."
    },
    {
      "id": "s_capacity_continuous_process",
      "kind": "state",
      "type_signature": "(Process, Set A) → [0,∞)",
      "name": "Capacity for continuous-time processes",
      "description": "Cap(A) = sup{μ(A) : supp(μ) ⊂ A, Gμ ≤ 1}; measures the size of A from the process's perspective, related to hitting probabilities and equilibrium measures."
    },
    {
      "id": "s_hunt_process",
      "kind": "axiom",
      "type_signature": "(Ω, X_t, θ_t, P_x) → StrongMarkovProcess",
      "name": "Hunt process",
      "description": "A strong Markov process with right-continuous paths and quasi-left-continuity; the standard framework for probabilistic potential theory, generalizing Feller processes."
    },
    {
      "id": "s_quasi_left_continuity",
      "kind": "axiom",
      "type_signature": "MarkovProcess → Prop",
      "name": "Quasi-left-continuity",
      "description": "For every increasing sequence of stopping times T_n ↑ T, X_{T_n} → X_T a.s. on {T < ∞}; prevents jumps at predictable times and is the key regularity assumption for Hunt processes."
    },
    {
      "id": "s_additive_functional",
      "kind": "axiom",
      "type_signature": "MarkovProcess → (ℝ₊ → ℝ₊)",
      "name": "Additive functional",
      "description": "A non-decreasing right-continuous process A_t with A_0 = 0 satisfying A_{t+s} = A_t + A_s ∘ θ_t; the building block for time changes and Revuz correspondence."
    },
    {
      "id": "s_revuz_measure",
      "kind": "state",
      "type_signature": "AdditiveFunc → Measure",
      "name": "Revuz measure",
      "description": "The unique σ-finite measure μ_A associated to a positive continuous additive functional via lim_{t↓0} (1/t) E_m[∫_0^t f(X_s) dA_s] = ∫ f dμ_A."
    },
    {
      "id": "s_revuz_correspondence",
      "kind": "theorem",
      "type_signature": "",
      "name": "Revuz correspondence",
      "description": "A bijection between positive continuous additive functionals (up to equivalence) and smooth measures via the Revuz measure; a cornerstone connecting additive functionals, Dirichlet forms, and measures."
    },
    {
      "id": "s_fine_topology",
      "kind": "axiom",
      "type_signature": "MarkovProcess → Topology",
      "name": "Fine topology",
      "description": "The coarsest topology making all excessive functions continuous; the natural topology for potential theory, in which thin sets are precisely those of capacity zero."
    },
    {
      "id": "t_time_change_markov",
      "kind": "technique",
      "function_signature": "(MarkovProcess X_t, continuous additive functional A_t) → (New MarkovProcess Y_s = X_{τ_s})",
      "name": "Time change of a Markov process",
      "description": "Defines Y_s = X_{τ_s} where τ_s = inf{t : A_t > s}; the time-changed process is again a strong Markov process with transformed generator and state space."
    },
    {
      "id": "t_killing_subprocess",
      "kind": "technique",
      "function_signature": "(MarkovProcess X_t, multiplicative functional M_t) → (Subprocess)",
      "name": "Killing and subprocess construction",
      "description": "Constructs a subprocess by killing X_t via a multiplicative functional M_t, yielding semigroup P̃_t f(x) = E_x[M_t f(X_t)]; amounts to modifying the generator by a killing rate."
    },
    {
      "id": "t_renewal_argument_mc",
      "kind": "technique",
      "function_signature": "(MC, regeneration point) → (Renewal equation/asymptotics)",
      "name": "Renewal argument for Markov chains",
      "description": "Exploits regenerative structure at return times to a recurrent state, reducing long-run averages and limit theorems to renewal theory."
    },
    {
      "id": "t_cycle_trick_mc",
      "kind": "technique",
      "function_signature": "(MC, recurrent state x) → (Cycle decomposition)",
      "name": "Cycle trick for Markov chains",
      "description": "Decomposes the trajectory into i.i.d. excursions from a reference state, enabling the law of large numbers, CLT, and large deviations for additive functionals."
    },
    {
      "id": "t_doeblin_coupling_mc",
      "kind": "technique",
      "function_signature": "(Two MC copies, Doeblin condition) → (Coupling time bound)",
      "name": "Doeblin's coupling method",
      "description": "Runs two copies of a Markov chain exploiting Doeblin's condition to ensure coalescence in bounded expected time; yields geometric convergence bounds."
    },
    {
      "id": "t_lyapunov_foster_criterion",
      "kind": "technique",
      "function_signature": "(MC, Lyapunov function V, drift condition) → (Positive recurrence/Geometric ergodicity)",
      "name": "Lyapunov function method (Foster's criterion)",
      "description": "Establishes positive recurrence or geometric ergodicity via a Lyapunov function V with PV ≤ V − ε outside a finite set; the drift condition PV ≤ λV + b·1_C with λ < 1 gives geometric ergodicity."
    },
    {
      "id": "s_foster_lyapunov_geometric_ergodicity",
      "kind": "theorem",
      "type_signature": "",
      "name": "Foster-Lyapunov criterion for geometric ergodicity",
      "description": "An irreducible aperiodic chain is geometrically ergodic if PV ≤ λV + b·1_C for V ≥ 1, λ < 1, b < ∞, and finite C; the convergence rate depends on λ."
    },
    {
      "id": "t_taboo_probability_technique",
      "kind": "technique",
      "function_signature": "(MC, forbidden set A) → (Restricted transition analysis)",
      "name": "Taboo probability technique",
      "description": "Analyzes the chain via transition probabilities conditioned on avoiding a set, yielding restricted Green functions and decomposition formulas for passage times and potentials."
    },
    {
      "id": "s_harris_recurrence",
      "kind": "axiom",
      "type_signature": "MC (general state space) → Prop",
      "name": "Harris recurrence",
      "description": "An irreducible chain on a general state space is Harris recurrent if every set A with ψ(A) > 0 is visited infinitely often a.s., where ψ is the irreducibility measure; the correct generalization of recurrence to uncountable spaces."
    },
    {
      "id": "t_doob_h_transform",
      "kind": "technique",
      "function_signature": "(MC, positive harmonic function h) → (h-transformed MC)",
      "name": "Doob's h-transform",
      "description": "Defines the transformed kernel P^h(x,y) = h(y)p(x,y)/h(x), yielding a new Markov chain; used to condition on events of probability zero such as never hitting a set."
    },
    {
      "id": "s_martin_boundary",
      "kind": "state",
      "type_signature": "TransientMC → CompactSpace",
      "name": "Martin boundary",
      "description": "A compactification of the state space via the Martin kernel K(x,y) = G(x,y)/G(x₀,y); boundary points represent extremal harmonic functions and classify all positive harmonic functions."
    },
    {
      "id": "s_martin_representation_theorem",
      "kind": "theorem",
      "type_signature": "",
      "name": "Martin representation theorem",
      "description": "Every positive harmonic function h for a transient chain has a unique representation h(x) = ∫_{∂_m} K(x,ξ) dν_h(ξ) over the minimal Martin boundary; the probabilistic Poisson integral formula."
    },
    {
      "id": "s_convergence_parameter",
      "kind": "state",
      "type_signature": "MC → [0,∞]",
      "name": "Convergence parameter",
      "description": "R = sup{r ≥ 0 : Σ_n r^n p^{(n)}(x,y) < ∞}; the radius of convergence of the Green function series, independent of x,y for irreducible chains, classifying the chain as R-recurrent or R-transient."
    },
    {
      "id": "s_R_recurrence_transience",
      "kind": "axiom",
      "type_signature": "MC → Prop",
      "name": "R-recurrence and R-transience",
      "description": "An irreducible chain is R-recurrent if Σ_n R^n p^{(n)}(x,y) = ∞ and R-transient if finite, where R is the convergence parameter; generalizes ordinary recurrence and determines existence of R-invariant measures."
    },
    {
      "id": "s_solidarity_theorem_general",
      "kind": "theorem",
      "type_signature": "",
      "name": "Solidarity theorem (general form)",
      "description": "For an irreducible chain, the convergence parameter R and the R-recurrence/R-transience classification are the same for all pairs (x,y); a unifying solidarity result encompassing period, recurrence, and convergence parameter."
    },
    {
      "id": "s_birth_death_chain_discrete",
      "kind": "axiom",
      "type_signature": "(p_n, q_n)_{n≥0} → Discrete MC",
      "name": "Birth-death chain (discrete time)",
      "description": "A discrete-time Markov chain on ℕ with transitions only to nearest neighbors: p(n,n+1) = p_n, p(n,n−1) = q_n; the simplest non-trivial class admitting explicit formulas for hitting times, stationary distributions, and spectral properties."
    },
    {
      "id": "t_subadditive_argument_period",
      "kind": "technique",
      "function_signature": "(Set of return times {n : p^{(n)}(x,x) > 0}) → (Period d = gcd)",
      "name": "Subadditive argument for period",
      "description": "Uses closure under addition of {n : p^{(n)}(x,x) > 0} and supermultiplicativity of transition probabilities to establish periodicity results and solidarity of period."
    },
    {
      "id": "s_wiener_test_discrete",
      "kind": "theorem",
      "type_signature": "",
      "name": "Wiener test (discrete potential theory)",
      "description": "A point z is regular for the discrete Dirichlet problem iff Σ_n Cap(A_n ∩ D^c)/Cap(A_n) = ∞ for annuli A_n around z; the discrete analogue of Wiener's regularity criterion."
    },
    {
      "id": "s_markov_kernel",
      "kind": "axiom",
      "name": "Markov kernel (transition kernel on measurable space)",
      "type_signature": "(X, B(X)) → [X × B(X) → [0,1]]",
      "description": "A function P: X × B(X) → [0,1] such that P(x, ·) is a probability measure for each x and P(·, A) is measurable for each A; the general-state-space analogue of a transition probability matrix."
    },
    {
      "id": "s_phi_irreducibility",
      "kind": "axiom",
      "name": "φ-irreducibility (general state space)",
      "type_signature": "MarkovKernel → Prop",
